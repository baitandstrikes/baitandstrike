      "id": "brand_logo",
      "label": "Brand logo",
      "info": "Upload logo Bait & Strike untuk ditampilkan di brand panel."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We're here to help with your fishing gear, orders, wholesale inquiries and more."
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send Us Your Question"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Your message has been sent successfully. We'll get back to you soon."
    },
    {
      "type": "url",
      "id": "map_embed",
      "label": "Google Maps embed URL",
      "info": "Paste URL dari atribut src iframe Google Maps."
    }
  ],
  "presets": [
    {
      "name": "BNS Premium Contact"
    }
  ]
}
{% endschema %}