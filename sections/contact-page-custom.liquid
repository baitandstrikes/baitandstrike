{% comment %}
  ============================================================
  BAIT & STRIKE — PREMIUM CONTACT PAGE
  Logo dapat di-upload melalui Theme Customizer
  ============================================================
{% endcomment %}

<section id="bns-contact-{{ section.id }}" class="bns-contact">

  <!-- HERO -->
  <div class="bns-contact__hero">

    <div class="bns-contact__hero-pattern"></div>

    <div class="bns-contact__hero-circle bns-contact__hero-circle--one"></div>
    <div class="bns-contact__hero-circle bns-contact__hero-circle--two"></div>

    <div class="bns-contact__hero-content">

      <div class="bns-contact__brand">
        BAIT & STRIKE
      </div>

      <h1>
        {{ section.settings.heading | escape }}
      </h1>

      <p>
        {{ section.settings.subheading | escape }}
      </p>

      <div class="bns-contact__hero-line"></div>

    </div>

  </div>


  <!-- MAIN -->
  <div class="bns-contact__container">


    <!-- CONTACT CARDS -->
    <div class="bns-contact__cards">


      <!-- LOCATION -->
      <div class="bns-contact__card">

        <div class="bns-contact__card-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
        </div>

        <div class="bns-contact__card-content">

          <span class="bns-contact__label">
            VISIT OUR STORE
          </span>

          <h2>
            Our Location
          </h2>

          <p>
            Jl. Makaliwe Raya No.36, RT.2/RW.5,<br>
            Grogol, Kec. Grogol Petamburan,<br>
            Kota Jakarta Barat,<br>
            Daerah Khusus Ibukota Jakarta 11450
          </p>

          <a
            href="https://www.google.com/maps/search/?api=1&query=Jl.+Makaliwe+Raya+No.36+Jakarta+Barat"
            target="_blank"
            rel="noopener"
            class="bns-contact__text-link"
          >
            GET DIRECTIONS
            <span>→</span>
          </a>

        </div>

      </div>


      <!-- PHONE -->
      <div class="bns-contact__card">

        <div class="bns-contact__card-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7.2 4.7 9.4 4c.6-.2 1.2.1 1.4.7l1 2.4c.2.5.1 1-.3 1.4L10 9.9a13.4 13.4 0 0 0 4.1 4.1l1.4-1.5c.4-.4.9-.5 1.4-.3l2.4 1c.6.2.9.8.7 1.4l-.7 2.2c-.2.6-.8 1-1.4 1C11.2 17.8 6.2 12.8 6.2 6.1c0-.6.4-1.2 1-1.4Z"/>
          </svg>
        </div>

        <div class="bns-contact__card-content">

          <span class="bns-contact__label">
            CALL OR MESSAGE
          </span>

          <h2>
            Phone & WhatsApp
          </h2>

          <a
            href="tel:087795361519"
            class="bns-contact__phone"
          >
            0877-9536-1519
          </a>

          <p>
            Need help with products,<br>
            orders or wholesale inquiries?
          </p>

          <a
            href="https://wa.me/6287795361519"
            target="_blank"
            rel="noopener"
            class="bns-contact__whatsapp"
          >

            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L.2 24l6.5-1.7a11.8 11.8 0 0 0 5.4 1.3h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.5-8.3ZM12.1 21.6c-1.7 0-3.3-.4-4.8-1.3l-.3-.2-3.9 1 1-3.8-.2-.3a9.7 9.7 0 0 1-1.5-5.2c0-5.4 4.4-9.8 9.8-9.8 2.6 0 5.1 1 6.9 2.9 1.8 1.8 2.9 4.3 2.9 6.9-.1 5.4-4.5 9.8-9.9 9.8Zm5.4-7.3c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.7.9-.8 1.1-.2.2-.3.2-.6.1-1.7-.8-2.8-1.5-3.9-3.4-.3-.5.3-.5.8-1.6.1-.2 0-.4 0-.5-.1-.1-.7-1.6-1-2.2-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.7.3-.2.3-1 1-1 2.5s1 2.9 1.1 3.1c.1.2 2 3.1 4.8 4.3 1.8.8 2.5.9 3.4.8.5-.1 1.7-.7 2-1.3.2-.6.2-1.1.1-1.2-.2-.2-.4-.3-.7-.4Z"/>
            </svg>

            CHAT ON WHATSAPP

          </a>

        </div>

      </div>


      <!-- HOURS -->
      <div class="bns-contact__card">

        <div class="bns-contact__card-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8"/>
            <path d="M12 7.5v4.9l3.1 1.8"/>
          </svg>
        </div>

        <div class="bns-contact__card-content">

          <span class="bns-contact__label">
            COME & VISIT
          </span>

          <h2>
            Opening Hours
          </h2>

          <div class="bns-contact__hours">

            <div class="bns-contact__hours-row">
              <span>MON — FRI</span>
              <strong>09:00 — 17:00</strong>
            </div>

            <div class="bns-contact__hours-row">
              <span>SATURDAY</span>
              <strong>09:00 — 13:30</strong>
            </div>

            <div class="bns-contact__hours-row bns-contact__hours-row--closed">
              <span>SUNDAY</span>
              <strong>CLOSED</strong>
            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- FORM + BRAND PANEL -->
    <div class="bns-contact__communication">


      <!-- CONTACT FORM -->
      <div class="bns-contact__form">

        <div class="bns-contact__form-heading">

          <span class="bns-contact__blue-label">
            GET IN TOUCH
          </span>

          <h2>
            {{ section.settings.form_heading | escape }}
          </h2>

          <p>
            Have a question about our products, orders or
            wholesale service? Send us a message.
          </p>

        </div>


        {% form 'contact', id: 'BNSContactForm' %}

          {% if form.posted_successfully? %}

            <div class="bns-contact__message bns-contact__message--success">

              <div class="bns-contact__message-icon">
                ✓
              </div>

              <div>
                <strong>MESSAGE SENT</strong>

                <span>
                  {{ section.settings.success_message | escape }}
                </span>
              </div>

            </div>

          {% endif %}


          {% if form.errors %}

            <div class="bns-contact__message bns-contact__message--error">
              {{ form.errors | default_errors }}
            </div>

          {% endif %}


          <div class="bns-contact__form-grid">


            <!-- NAME -->
            <div class="bns-contact__field">

              <label for="BNSContactName-{{ section.id }}">
                NAME <span>*</span>
              </label>

              <input
                id="BNSContactName-{{ section.id }}"
                type="text"
                name="contact[name]"
                value="{{ form.name | escape }}"
                placeholder="Your name"
                autocomplete="name"
                required
              >

            </div>


            <!-- EMAIL -->
            <div class="bns-contact__field">

              <label for="BNSContactEmail-{{ section.id }}">
                EMAIL <span>*</span>
              </label>

              <input
                id="BNSContactEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="your@email.com"
                autocomplete="email"
                required
              >

            </div>

          </div>


          <!-- MESSAGE -->
          <div class="bns-contact__field">

            <label for="BNSContactMessage-{{ section.id }}">
              MESSAGE <span>*</span>
            </label>

            <textarea
              id="BNSContactMessage-{{ section.id }}"
              name="contact[body]"
              rows="6"
              placeholder="Tell us how we can help..."
              required
            >{{ form.body | escape }}</textarea>

          </div>


          <!-- SUBMIT -->
          <button
            type="submit"
            class="bns-contact__submit"
          >

            <span>
              SEND MESSAGE
            </span>

            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h15"/>
              <path d="m13 5 7 7-7 7"/>
            </svg>

          </button>

        {% endform %}

      </div>


      <!-- BRAND PANEL -->
      <div class="bns-contact__brand-panel">

        <div class="bns-contact__brand-watermark">
          BNS
        </div>


        <!-- UPLOADABLE LOGO -->
        <div class="bns-contact__brand-box">

          {% if section.settings.brand_logo != blank %}

            {{
              section.settings.brand_logo
              | image_url: width: 500
              | image_tag:
                loading: 'lazy',
                widths: '100, 200, 300, 500',
                sizes: '72px',
                alt: shop.name
            }}

          {% else %}

            <span>BNS</span>

          {% endif %}

        </div>


        <span class="bns-contact__yellow-label">
          BAIT & STRIKE
        </span>

        <h2>
          Let's Talk<br>
          <em>Fishing.</em>
        </h2>

        <p>
          Whether you need help choosing the right fishing gear,
          have a question about an order, or want to discuss
          wholesale opportunities, we're ready to help.
        </p>


        <div class="bns-contact__benefits">

          <div>
            <span>01</span>
            <strong>Expert Support</strong>
          </div>

          <div>
            <span>02</span>
            <strong>Quality Fishing Gear</strong>
          </div>

          <div>
            <span>03</span>
            <strong>Fast Response</strong>
          </div>

        </div>


        <a
          href="https://wa.me/6287795361519"
          target="_blank"
          rel="noopener"
          class="bns-contact__panel-button"
        >
          TALK TO US
          <span>→</span>
        </a>

      </div>

    </div>


    <!-- MAP -->
    <div class="bns-contact__map-section">

      <div class="bns-contact__map-header">

        <div>

          <span class="bns-contact__blue-label">
            FIND US
          </span>

          <h2>
            Come Visit Us
          </h2>

        </div>

        <a
          href="https://www.google.com/maps/search/?api=1&query=Jl.+Makaliwe+Raya+No.36+Jakarta+Barat"
          target="_blank"
          rel="noopener"
        >
          OPEN GOOGLE MAPS →
        </a>

      </div>


      <div class="bns-contact__map">

        {% if section.settings.map_embed != blank %}

          <iframe
            src="{{ section.settings.map_embed | escape }}"
            title="Bait & Strike Location"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen>
          </iframe>

        {% else %}

          <div class="bns-contact__map-placeholder">

            <div class="bns-contact__map-pin">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/>
                <circle cx="12" cy="9" r="2.5"/>
              </svg>

            </div>

            <strong>
              BAIT & STRIKE
            </strong>

            <span>
              Jl. Makaliwe Raya No.36, Jakarta Barat
            </span>

            <a
              href="https://www.google.com/maps/search/?api=1&query=Jl.+Makaliwe+Raya+No.36+Jakarta+Barat"
              target="_blank"
              rel="noopener"
            >
              GET DIRECTIONS →
            </a>

          </div>

        {% endif %}

      </div>

    </div>

  </div>

</section>


<style>

#bns-contact-{{ section.id }} {

  --bns-blue: #3282C0;
  --bns-blue-dark: #236b9f;
  --bns-navy: #071f34;
  --bns-yellow: #FCDD16;

  --bns-white: #ffffff;
  --bns-light: #f5f8fa;
  --bns-border: #dce5ea;

  --bns-text: #17232d;
  --bns-muted: #697984;

  width: 100%;
  overflow: hidden;

  background: #fff;
  color: var(--bns-text);

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


#bns-contact-{{ section.id }} *,
#bns-contact-{{ section.id }} *::before,
#bns-contact-{{ section.id }} *::after {
  box-sizing: border-box;
}


/* ==========================================================
   HERO
========================================================== */

#bns-contact-{{ section.id }} .bns-contact__hero {

  position: relative;

  min-height: 330px;

  display: flex;
  align-items: center;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 85% 20%,
      rgba(50,130,192,.38),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #061a2b 0%,
      #0a3150 55%,
      #155f8e 100%
    );
}


#bns-contact-{{ section.id }} .bns-contact__hero-pattern {

  position: absolute;
  inset: 0;

  opacity: .045;

  background-image:
    linear-gradient(
      45deg,
      #fff 25%,
      transparent 25%
    ),
    linear-gradient(
      -45deg,
      #fff 25%,
      transparent 25%
    );

  background-size: 80px 80px;
}


#bns-contact-{{ section.id }} .bns-contact__hero-circle {

  position: absolute;

  border:
    1px solid
    rgba(252,221,22,.25);

  border-radius: 50%;
}


#bns-contact-{{ section.id }} .bns-contact__hero-circle--one {

  width: 520px;
  height: 520px;

  right: -170px;
  top: -270px;
}


#bns-contact-{{ section.id }} .bns-contact__hero-circle--two {

  width: 300px;
  height: 300px;

  right: -40px;
  top: -160px;

  border-color:
    rgba(255,255,255,.08);
}


#bns-contact-{{ section.id }} .bns-contact__hero-content {

  position: relative;
  z-index: 2;

  width:
    min(1180px, calc(100% - 48px));

  margin: auto;

  padding: 70px 0;
}


#bns-contact-{{ section.id }} .bns-contact__brand {

  display: flex;
  align-items: center;
  gap: 10px;

  color: var(--bns-yellow);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: .25em;
}


#bns-contact-{{ section.id }} .bns-contact__brand::before {

  content: "";

  width: 30px;
  height: 2px;

  background: var(--bns-yellow);
}


#bns-contact-{{ section.id }} .bns-contact__hero h1 {

  margin: 15px 0 14px;

  color: #fff;

  font-size:
    clamp(46px, 7vw, 82px);

  line-height: .9;

  font-weight: 900;

  letter-spacing: -.055em;
}


#bns-contact-{{ section.id }} .bns-contact__hero p {

  max-width: 610px;

  margin: 0;

  color: rgba(255,255,255,.72);

  font-size: 14px;

  line-height: 1.7;
}


#bns-contact-{{ section.id }} .bns-contact__hero-line {

  width: 72px;
  height: 4px;

  margin-top: 27px;

  background: var(--bns-yellow);
}


/* ==========================================================
   CONTAINER
========================================================== */

#bns-contact-{{ section.id }} .bns-contact__container {

  width:
    min(1180px, calc(100% - 48px));

  margin: auto;
}


/* ==========================================================
   CARDS
========================================================== */

#bns-contact-{{ section.id }} .bns-contact__cards {

  position: relative;
  z-index: 5;

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;

  margin-top: -48px;
}


#bns-contact-{{ section.id }} .bns-contact__card {

  position: relative;

  display: grid;

  grid-template-columns: 52px 1fr;

  gap: 20px;

  min-height: 250px;

  padding: 30px;

  background: #fff;

  border:
    1px solid
    var(--bns-border);

  box-shadow:
    0 20px 55px
    rgba(7,31,52,.11);

  transition:
    transform .3s ease,
    box-shadow .3s ease;
}


#bns-contact-{{ section.id }} .bns-contact__card:hover {

  transform:
    translateY(-7px);

  box-shadow:
    0 28px 65px
    rgba(7,31,52,.16);
}


#bns-contact-{{ section.id }} .bns-contact__card-icon {

  position: relative;

  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  color: #fff;

  background:
    var(--bns-blue);
}


#bns-contact-{{ section.id }} .bns-contact__card-icon::after {

  content: "";

  position: absolute;

  width: 14px;
  height: 14px;

  right: -5px;
  bottom: -5px;

  background:
    var(--bns-yellow);
}


#bns-contact-{{ section.id }} .bns-contact__card-icon svg {

  width: 25px;
  height: 25px;
}


#bns-contact-{{ section.id }} .bns-contact__card-icon path,
#bns-contact-{{ section.id }} .bns-contact__card-icon circle {

  fill: none;

  stroke: currentColor;

  stroke-width: 1.7;
}


#bns-contact-{{ section.id }} .bns-contact__label,
#bns-contact-{{ section.id }} .bns-contact__blue-label {

  display: inline-flex;

  align-items: center;
  gap: 8px;

  color: var(--bns-blue);

  font-size: 9px;

  font-weight: 900;

  letter-spacing: .16em;
}


#bns-contact-{{ section.id }} .bns-contact__card h2 {

  margin: 7px 0 13px;

  color: var(--bns-navy);

  font-size: 20px;

  line-height: 1.15;

  font-weight: 900;
}


#bns-contact-{{ section.id }} .bns-contact__card p {

  margin: 0;

  color: var(--bns-muted);

  font-size: 11px;

  line-height: 1.7;
}


#bns-contact-{{ section.id }} .bns-contact__text-link {

  display: inline-flex;

  align-items: center;

  gap: 9px;

  margin-top: 17px;

  color: var(--bns-blue);

  text-decoration: none;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: .08em;
}


#bns-contact-{{ section.id }} .bns-contact__text-link span {

  transition:
    transform .2s ease;
}


#bns-contact-{{ section.id }} .bns-contact__text-link:hover span {

  transform:
    translateX(5px);
}


/* ==========================================================
   PHONE
========================================================== */

#bns-contact-{{ section.id }} .bns-contact__phone {

  display: block;

  margin:
    5px 0 10px;

  color: var(--bns-blue);

  text-decoration: none;

  font-size: 20px;

  line-height: 1;

  font-weight: 900;
}


#bns-contact-{{ section.id }} .bns-contact__whatsapp {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  margin-top: 15px;

  padding:
    11px 13px;

  background:
    var(--bns-yellow);

  color: #101820;

  text-decoration: none;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: .05em;

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}


#bns-contact-{{ section.id }} .bns-contact__whatsapp:hover {

  transform:
    translateY(-2px);

  box-shadow:
    0 9px 20px
    rgba(252,221,22,.35);
}


#bns-contact-{{ section.id }} .bns-contact__whatsapp svg {

  width: 15px;
  height: 15px;

  fill: currentColor;
}


/* ==========================================================
   HOURS
========================================================== */

#bns-contact-{{ section.id }} .bns-contact__hours {

  display: grid;

  gap: 11px;
}


#bns-contact-{{ section.id }} .bns-contact__hours-row {

  display: flex;

  justify-content:
    space-between;

  gap: 10px;

  padding-bottom: 10px;

  border-bottom:
    1px solid
    var(--bns-border);
}


#bns-contact-{{ section.id }} .bns-contact__hours-row span {

  color: var(--bns-muted);

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .06em;
}


#bns-contact-{{ section.id }} .bns-contact__hours-row strong {

  color: var(--bns-navy);

  font-size: 10px;

  font-weight: 800;
}


#bns-contact-{{ section.id }} .bns-contact__hours-row--closed strong {

  color: #999;
}


/* ==========================================================
   FORM
========================================================== */

#bns-contact-{{ section.id }} .bns-contact__communication {

  display: grid;

  grid-template-columns:
    1.3fr .7fr;

  margin:
    80px 0;

  background:
    var(--bns-light);
}


#bns-contact-{{ section.id }} .bns-contact__form {

  padding:
    55px;

  background:
    #fff;
}


#bns-contact-{{ section.id }} .bns-contact__form-heading h2 {

  margin:
    12px 0 10px;

  color:
    var(--bns-navy);

  font-size:
    35px;

  line-height:
    1;

  font-weight:
    900;

  letter-spacing:
    -.035em;
}


#bns-contact-{{ section.id }} .bns-contact__form-heading p {

  max-width:
    520px;

  margin:
    0 0 32px;

  color:
    var(--bns-muted);

  font-size:
    12px;

  line-height:
    1.7;
}


#bns-contact-{{ section.id }} .bns-contact__form-grid {

  display:
    grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap:
    18px;
}


#bns-contact-{{ section.id }} .bns-contact__field {

  margin-bottom:
    18px;
}


#bns-contact-{{ section.id }} label {

  display:
    block;

  margin-bottom:
    8px;

  color:
    var(--bns-navy);

  font-size:
    9px;

  font-weight:
    900;

  letter-spacing:
    .1em;
}


#bns-contact-{{ section.id }} label span {

  color:
    #e33;
}


#bns-contact-{{ section.id }} input,
#bns-contact-{{ section.id }} textarea {

  width:
    100%;

  border:
    1px solid
    #d7e0e5;

  border-radius:
    0;

  outline:
    none;

  background:
    #f8fafb;

  color:
    var(--bns-text);

  font-family:
    inherit;

  font-size:
    12px;

  transition:
    border-color .2s ease,
    background .2s ease,
    box-shadow .2s ease;
}


#bns-contact-{{ section.id }} input {

  height:
    49px;

  padding:
    0 14px;
}


#bns-contact-{{ section.id }} textarea {

  min-height:
    145px;

  padding:
    14px;

  resize:
    vertical;
}


#bns-contact-{{ section.id }} input::placeholder,
#bns-contact-{{ section.id }} textarea::placeholder {

