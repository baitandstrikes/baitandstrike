{% comment %}
  BAITANDSTRIKE — B2B About Us
  FULL VERSION
  HERO IMAGE ABOVE + CONTENT BELOW

  FEATURES:
  - Hero image upload
  - Hero image position
  - Hero overlay on image
  - Text completely below image
  - Responsive desktop/tablet/mobile
  - Reveal animation
  - BNS blue + yellow system
  - Functional buttons
{% endcomment %}

<section id="BNS-about-{{ section.id }}" class="bns-about">

  <!-- =====================================================
       HERO IMAGE
       ===================================================== -->

  <div class="bns-about__hero">

    {% if section.settings.hero_background != blank %}

      <div class="bns-about__hero-media">

        {{
          section.settings.hero_background
          | image_url: width: 2400
          | image_tag:
            class: 'bns-about__hero-image',
            loading: 'eager',
            widths: '600,900,1200,1600,2000,2400',
            sizes: '100vw',
            alt: ''
        }}

        <div
          class="bns-about__hero-image-overlay"
          style="
            --bns-hero-overlay: {{ section.settings.hero_overlay | divided_by: 100.0 }};
            --bns-hero-overlay-secondary: {{ section.settings.hero_overlay | times: 0.75 | divided_by: 100.0 }};
          "
        ></div>

      </div>

    {% endif %}


    <!-- ===================================================
         HERO CONTENT
         =================================================== -->

    <div class="bns-about__hero-content">

      <div class="bns-about__hero-decoration"></div>

      <div class="bns-about__hero-inner">

        {% if section.settings.eyebrow != blank %}

          <span class="bns-eyebrow">
            {{ section.settings.eyebrow }}
          </span>

        {% endif %}


        {% if section.settings.heading != blank %}

          <h1>
            {{ section.settings.heading }}
          </h1>

        {% endif %}


        {% if section.settings.hero_text != blank %}

          <p class="bns-about__hero-text">
            {{ section.settings.hero_text }}
          </p>

        {% endif %}


        <div class="bns-about__actions">

          {% if section.settings.primary_label != blank %}

            <a
              class="bns-btn bns-btn--primary"
              href="{{ section.settings.primary_link | default: '#' }}"
            >
              {{ section.settings.primary_label }}
            </a>

          {% endif %}


          {% if section.settings.secondary_label != blank %}

            <a
              class="bns-btn bns-btn--ghost"
              href="{{ section.settings.secondary_link | default: '#' }}"
            >
              {{ section.settings.secondary_label }}
            </a>

          {% endif %}

        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       MAIN CONTENT
       ===================================================== -->

  <div class="bns-about__container">


    <!-- ===================================================
         INTRO
         =================================================== -->

    <div class="bns-intro bns-reveal">

      <div>

        {% if section.settings.intro_eyebrow != blank %}

          <span class="bns-eyebrow">
            {{ section.settings.intro_eyebrow }}
          </span>

        {% endif %}


        {% if section.settings.intro_heading != blank %}

          <h2>
            {{ section.settings.intro_heading }}
          </h2>

        {% endif %}

      </div>


      <div class="bns-intro__copy">

        {{ section.settings.intro_text }}

      </div>

    </div>


    <!-- ===================================================
         STATS
         =================================================== -->

    <div class="bns-stats">

      {% for block in section.blocks %}

        {% if block.type == 'stat' %}

          <div
            class="bns-stat bns-reveal"
            {{ block.shopify_attributes }}
          >

            <strong>
              {{ block.settings.number }}
            </strong>

            <span>
              {{ block.settings.label }}
            </span>

          </div>

        {% endif %}

      {% endfor %}

    </div>


    <!-- ===================================================
         SERVICES
         =================================================== -->

    <div class="bns-section-head bns-reveal">

      {% if section.settings.services_eyebrow != blank %}

        <span class="bns-eyebrow">
          {{ section.settings.services_eyebrow }}
        </span>

      {% endif %}


      {% if section.settings.services_heading != blank %}

        <h2>
          {{ section.settings.services_heading }}
        </h2>

      {% endif %}

    </div>


    <div class="bns-cards">

      {% assign service_index = 0 %}

      {% for block in section.blocks %}

        {% if block.type == 'service' %}

          {% assign service_index = service_index | plus: 1 %}

          <article
            class="bns-card bns-reveal"
            {{ block.shopify_attributes }}
          >

            <div class="bns-card__top">

              <div class="bns-card__number">

                {% if service_index < 10 %}
                  0{{ service_index }}
                {% else %}
                  {{ service_index }}
                {% endif %}

              </div>

              <div class="bns-card__dot"></div>

            </div>


            {% if block.settings.title != blank %}

              <h3>
                {{ block.settings.title }}
              </h3>

            {% endif %}


            {% if block.settings.text != blank %}

              <p>
                {{ block.settings.text }}
              </p>

            {% endif %}

          </article>

        {% endif %}

      {% endfor %}

    </div>


    <!-- ===================================================
         AUDIENCE
         =================================================== -->

    <div class="bns-audience bns-reveal">

      <div class="bns-section-head">

        {% if section.settings.audience_eyebrow != blank %}

          <span class="bns-eyebrow">
            {{ section.settings.audience_eyebrow }}
          </span>

        {% endif %}


        {% if section.settings.audience_heading != blank %}

          <h2>
            {{ section.settings.audience_heading }}
          </h2>

        {% endif %}

      </div>


      <div class="bns-audience__grid">

        {% for block in section.blocks %}

          {% if block.type == 'audience' %}

            <div
              class="bns-audience__item"
              {{ block.shopify_attributes }}
            >

              <span class="bns-audience__icon">
                {{ block.settings.icon }}
              </span>


              <div>

                {% if block.settings.title != blank %}

                  <h3>
                    {{ block.settings.title }}
                  </h3>

                {% endif %}


                {% if block.settings.text != blank %}

                  <p>
                    {{ block.settings.text }}
                  </p>

                {% endif %}

              </div>

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>


    <!-- ===================================================
         WHY BAITANDSTRIKE
         =================================================== -->

    <div class="bns-why bns-reveal">

      <div class="bns-section-head">

        {% if section.settings.why_eyebrow != blank %}

          <span class="bns-eyebrow">
            {{ section.settings.why_eyebrow }}
          </span>

        {% endif %}


        {% if section.settings.why_heading != blank %}

          <h2>
            {{ section.settings.why_heading }}
          </h2>

        {% endif %}

      </div>


      <div class="bns-why__grid">

        {% for block in section.blocks %}

          {% if block.type == 'why' %}

            <div
              class="bns-why__item"
              {{ block.shopify_attributes }}
            >

              <strong>
                {{ block.settings.number }}
              </strong>


              {% if block.settings.title != blank %}

                <h3>
                  {{ block.settings.title }}
                </h3>

              {% endif %}


              {% if block.settings.text != blank %}

                <p>
                  {{ block.settings.text }}
                </p>

              {% endif %}

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>


  <!-- =====================================================
       CTA
       ===================================================== -->

  <div class="bns-about__cta bns-reveal">

    <div class="bns-about__cta-pattern"></div>

    <div class="bns-about__cta-inner">

      {% if section.settings.cta_eyebrow != blank %}

        <span class="bns-eyebrow">
          {{ section.settings.cta_eyebrow }}
        </span>

      {% endif %}


      {% if section.settings.cta_heading != blank %}

        <h2>
          {{ section.settings.cta_heading }}
        </h2>

      {% endif %}


      {% if section.settings.cta_text != blank %}

        <p>
          {{ section.settings.cta_text }}
        </p>

      {% endif %}


      {% if section.settings.cta_label != blank %}

        <a
          class="bns-btn bns-btn--yellow"
          href="{{ section.settings.cta_link | default: '#' }}"
        >
          {{ section.settings.cta_label }}
        </a>

      {% endif %}

    </div>

  </div>

</section>


<style>

  /* =========================================================
     BNS BASE
     ========================================================= */

  #BNS-about-{{ section.id }} {

    --bns-blue: #3282C0;
    --bns-yellow: #FCDD16;

    --bns-blue-dark: #17547F;
    --bns-blue-deep: #123F5F;
    --bns-blue-light: #EAF5FC;

    --bns-white: #FFFFFF;
    --bns-black: #14212B;

    --bns-text: #263746;
    --bns-muted: #647786;

    --bns-line: rgba(50,130,192,.16);

    background: #FFFFFF;

    color: var(--bns-text);

    position: relative;

    overflow: hidden;

    isolation: isolate;

    font-family: inherit;

  }


  #BNS-about-{{ section.id }} * {

    box-sizing: border-box;

  }


  /* =========================================================
     HERO
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__hero {

    position: relative;

    width: 100%;

    overflow: hidden;

    background: #FFFFFF;

  }


  /* =========================================================
     HERO IMAGE
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__hero-media {

    position: relative !important;

    width: 100% !important;

    height: clamp(320px, 42vw, 580px) !important;

    overflow: hidden !important;

    display: block !important;

    margin: 0 !important;

    padding: 0 !important;

    border: 0 !important;

    background: #3282C0;

    z-index: 1;

  }


  #BNS-about-{{ section.id }} .bns-about__hero-image {

    position: absolute !important;

    inset: 0 !important;

    display: block !important;

    width: 100% !important;

    height: 100% !important;

    min-width: 100% !important;

    min-height: 100% !important;

    max-width: none !important;

    max-height: none !important;

    margin: 0 !important;

    padding: 0 !important;

    border: 0 !important;

    outline: none !important;

    box-shadow: none !important;

    object-fit: cover !important;

    object-position:
      {{ section.settings.hero_background_position }}
      !important;

    transition:
      transform 1.2s ease;

  }


  #BNS-about-{{ section.id }} .bns-about__hero-media:hover
  .bns-about__hero-image {

    transform: scale(1.035);

  }


  /* =========================================================
     HERO IMAGE OVERLAY
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__hero-image-overlay {

    position: absolute !important;

    inset: 0 !important;

    width: 100% !important;

    height: 100% !important;

    margin: 0 !important;

    padding: 0 !important;

    border: 0 !important;

    pointer-events: none !important;

    background:

      linear-gradient(
        90deg,
        rgba(
          20,
          80,
          125,
          var(--bns-hero-overlay)
        ),
        rgba(
          50,
          130,
          192,
          var(--bns-hero-overlay-secondary)
        )
      ) !important;

    z-index: 2;

  }


  /* =========================================================
     HERO CONTENT
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__hero-content {

    position: relative;

    width: 100%;

    overflow: hidden;

    background:

      radial-gradient(
        circle at 88% 15%,
        rgba(252,221,22,.20),
        transparent 25%
      ),

      radial-gradient(
        circle at 8% 90%,
        rgba(255,255,255,.08),
        transparent 28%
      ),

      linear-gradient(
        135deg,
        #3282C0 0%,
        #2C75AE 50%,
        #24689D 100%
      );

    color: #FFFFFF;

    z-index: 3;

  }


  /* =========================================================
     HERO DECORATION
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__hero-decoration {

    position: absolute;

    width: 480px;

    height: 480px;

    right: -220px;

    top: -250px;

    border: 80px solid rgba(255,255,255,.055);

    border-radius: 50%;

    pointer-events: none;

  }


  #BNS-about-{{ section.id }} .bns-about__hero-decoration:after {

    content: "";

    position: absolute;

    width: 220px;

    height: 220px;

    left: 50px;

    top: 50px;

    border: 35px solid rgba(252,221,22,.13);

    border-radius: 50%;

  }


  /* =========================================================
     HERO WATERMARK
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__hero-content:after {

    content: "BAITANDSTRIKE";

    position: absolute;

    right: -2%;

    bottom: -12px;

    font-size: clamp(65px,11vw,165px);

    line-height: .8;

    font-weight: 900;

    letter-spacing: -.08em;

    color: rgba(255,255,255,.045);

    pointer-events: none;

    white-space: nowrap;

    z-index: 1;

  }


  /* =========================================================
     HERO INNER
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__hero-inner {

    position: relative;

    z-index: 4;

    width: min(
      1180px,
      calc(100% - 40px)
    );

    margin: 0 auto;

    padding: 72px 0 78px;

  }


  /* =========================================================
     HERO EYEBROW
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-eyebrow {

    display: inline-block;

    color: var(--bns-yellow);

    font-size: 12px;

    line-height: 1.2;

    font-weight: 900;

    letter-spacing: .18em;

    text-transform: uppercase;

    margin-bottom: 18px;

  }


  /* =========================================================
     HERO HEADING
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__hero-inner h1 {

    max-width: 850px;

    margin: 0 0 25px;

    font-size: clamp(
      44px,
      6vw,
      78px
    );

    line-height: .95;

    letter-spacing: -.055em;

    font-weight: 900;

    color: #FFFFFF;

  }


  /* =========================================================
     HERO TEXT
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__hero-text {

    max-width: 720px;

    margin: 0 0 34px;

    color: rgba(255,255,255,.91);

    font-size: 18px;

    line-height: 1.75;

  }


  /* =========================================================
     BUTTONS
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__actions {

    display: flex;

    flex-wrap: wrap;

    gap: 12px;

  }


  #BNS-about-{{ section.id }} .bns-btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 52px;

    padding: 0 27px;

    border-radius: 4px;

    text-decoration: none;

    text-transform: uppercase;

    letter-spacing: .08em;

    font-size: 12px;

    line-height: 1;

    font-weight: 900;

    cursor: pointer;

    transition:
      transform .25s ease,
      background .25s ease,
      color .25s ease,
      box-shadow .25s ease;

  }


  #BNS-about-{{ section.id }} .bns-btn:hover {

    transform: translateY(-3px);

  }


  #BNS-about-{{ section.id }} .bns-btn--primary {

    background: var(--bns-yellow);

    color: #16222B;

    box-shadow:
      0 8px 25px rgba(252,221,22,.20);

  }


  #BNS-about-{{ section.id }} .bns-btn--primary:hover {

    background: #FFE84B;

    color: #16222B;

    box-shadow:
      0 12px 30px rgba(252,221,22,.30);

  }


  #BNS-about-{{ section.id }} .bns-btn--ghost {

    background: transparent;

    color: #FFFFFF;

    border: 2px solid rgba(255,255,255,.75);

  }


  #BNS-about-{{ section.id }} .bns-btn--ghost:hover {

    background: #FFFFFF;

    border-color: #FFFFFF;

    color: var(--bns-blue);

  }


  #BNS-about-{{ section.id }} .bns-btn--yellow {

    background: var(--bns-yellow);

    color: #17222A;

    box-shadow:
      0 10px 30px rgba(252,221,22,.22);

  }


  #BNS-about-{{ section.id }} .bns-btn--yellow:hover {

    background: #FFE84B;

    color: #17222A;

    transform: translateY(-3px) scale(1.02);

  }


  /* =========================================================
     MAIN
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-about__container {

    width: min(
      1180px,
      calc(100% - 40px)
    );

    margin: 0 auto;

    padding: 100px 0;

    background: #FFFFFF;

  }


  /* =========================================================
     INTRO
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-intro {

    display: grid;

    grid-template-columns: .9fr 1.1fr;

    gap: 80px;

    align-items: start;

    padding-bottom: 70px;

    border-bottom: 1px solid var(--bns-line);

  }


  #BNS-about-{{ section.id }} .bns-intro h2 {

    margin: 0;

    font-size: clamp(
      34px,
      4vw,
      54px
    );

    line-height: 1.02;

    letter-spacing: -.045em;

    font-weight: 850;

    color: var(--bns-blue-dark);

  }


  #BNS-about-{{ section.id }} .bns-intro__copy {

    color: var(--bns-muted);

    font-size: 17px;

    line-height: 1.85;

    max-width: 650px;

  }


  #BNS-about-{{ section.id }} .bns-intro__copy p:last-child {

    margin-bottom: 0;

  }


  /* =========================================================
     COMMON H2
     ========================================================= */

  #BNS-about-{{ section.id }} h2 {

    font-size: clamp(
      34px,
      4vw,
      54px
    );

    line-height: 1.02;

    letter-spacing: -.045em;

    font-weight: 850;

    color: var(--bns-blue-dark);

    margin: 0 0 18px;

  }


  #BNS-about-{{ section.id }} h3 {

    margin-top: 0;

  }


  /* =========================================================
     STATS
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-stats {

    display: grid;

    grid-template-columns: repeat(4,1fr);

    gap: 1px;

    background: var(--bns-line);

    margin: 70px 0 110px;

    border: 1px solid var(--bns-line);

    overflow: hidden;

  }


  #BNS-about-{{ section.id }} .bns-stat {

    position: relative;

    padding: 35px 25px;

    background: #FFFFFF;

    transition:
      background .25s ease,
      transform .25s ease;

  }


  #BNS-about-{{ section.id }} .bns-stat:hover {

    background: var(--bns-blue-light);

  }


  #BNS-about-{{ section.id }} .bns-stat:before {

    content: "";

    position: absolute;

    top: 0;

    left: 0;

    width: 100%;

    height: 4px;

    background: var(--bns-yellow);

  }


  #BNS-about-{{ section.id }} .bns-stat strong {

    display: block;

    color: var(--bns-blue);

    font-size: 38px;

    line-height: 1;

    margin-bottom: 10px;

    font-weight: 900;

  }


  #BNS-about-{{ section.id }} .bns-stat span {

    color: var(--bns-muted);

    font-size: 13px;

    text-transform: uppercase;

    letter-spacing: .1em;

    font-weight: 700;

  }


  /* =========================================================
     SECTION HEAD
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-section-head {

    margin-bottom: 40px;

  }


  /* =========================================================
     SERVICE CARDS
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-cards {

    display: grid;

    grid-template-columns: repeat(4,1fr);

    gap: 14px;

    margin-bottom: 130px;

  }


  #BNS-about-{{ section.id }} .bns-card {

    position: relative;

    min-height: 270px;

    padding: 30px;

    border: 1px solid var(--bns-line);

    background:
      linear-gradient(
        145deg,
        #FFFFFF,
        #F7FBFE
      );

    overflow: hidden;

    transition:
      transform .3s ease,
      border-color .3s ease,
      box-shadow .3s ease;

  }


  #BNS-about-{{ section.id }} .bns-card:after {

    content: "";

    position: absolute;

    width: 130px;

    height: 130px;

    right: -65px;

    bottom: -65px;

    border-radius: 50%;

    background: rgba(50,130,192,.08);

    transition:
      transform .4s ease;

  }


  #BNS-about-{{ section.id }} .bns-card:hover {

    transform: translateY(-8px);

    border-color: var(--bns-blue);

    box-shadow:
      0 15px 40px rgba(50,130,192,.12);

  }


  #BNS-about-{{ section.id }} .bns-card:hover:after {

    transform: scale(1.6);

  }


  #BNS-about-{{ section.id }} .bns-card__top {

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 65px;

  }


  #BNS-about-{{ section.id }} .bns-card__number {

    color: var(--bns-blue);

    font-weight: 900;

    font-size: 12px;

    letter-spacing: .1em;

  }


  #BNS-about-{{ section.id }} .bns-card__dot {

    width: 10px;

    height: 10px;

    flex: 0 0 10px;

    border-radius: 50%;

    background: var(--bns-yellow);

    box-shadow:
      0 0 0 5px rgba(252,221,22,.14);

  }


  #BNS-about-{{ section.id }} .bns-card h3,
  #BNS-about-{{ section.id }} .bns-audience__item h3,
  #BNS-about-{{ section.id }} .bns-why__item h3 {

    font-size: 19px;

    margin: 0 0 12px;

    color: var(--bns-blue-dark);

    font-weight: 800;

  }


  #BNS-about-{{ section.id }} .bns-card p,
  #BNS-about-{{ section.id }} .bns-audience__item p,
  #BNS-about-{{ section.id }} .bns-why__item p {

    color: var(--bns-muted);

    font-size: 14px;

    line-height: 1.7;

    margin: 0;

  }


  /* =========================================================
     AUDIENCE
     ========================================================= */

  #BNS-about-{{ section.id }} .bns-audience {

    position: relative;

    padding: 90px 0;

    margin-bottom: 90px;

    border-top: 1px solid var(--bns-line);

    border-bottom: 1px solid var(--bns-line);

  }


  #BNS-about-{{ section.id }} .bns-audience:before {

    content: "";

    position: absolute;

    width: 220px;

    height: 220px;

    right: -120px;

    top: 40px;

    border-radius: 50%;

    background: var(--bns-blue-light);

    pointer-events: none;

  }


  #BNS-about-{{ section.id }} .bns-audience__grid {

    position: relative;

    z-index: 1;

    display: grid;

    grid-template-columns: repeat(2,1fr);

    gap: 1px;

    background: var(--bns-line);

    border: 1px solid var(--bns-line);

  }


  #BNS-about-{{ section.id }} .bns-audience__item {

    display: flex;

    gap: 20px;

    padding: 30px;

    background: #FFFFFF;

    transition:
      background .25s ease,
      transform .25s ease;

  }


  #BNS-about-{{ section.id }} .bns-audience__item:hover {

    background: var(--bns-blue-light);

    transform: translateX(4px);

  }


  #BNS-about-{{ section.id }} .bns-audience__icon {

    flex: 0 0 44px;

    width: 44px;

    height: 44px;

    display: grid;

    place-items: center;

