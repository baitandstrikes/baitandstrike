{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .baitandstrike-benefits-{{ section.id }} {
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    box-sizing: border-box;
  }

  .baitandstrike-benefits__grid-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 35px 45px;
    padding: 0 25px;
  }

  .baitandstrike-benefit-{{ section.id }} {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    color: {{ section.settings.text_color }};
  }

  .baitandstrike-benefit__icon-{{ section.id }} {
    flex: 0 0 58px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: {{ section.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 27px;
    transition: all 0.3s ease;
  }

  .baitandstrike-benefit-{{ section.id }}:hover .baitandstrike-benefit__icon-{{ section.id }} {
    transform: translateY(-5px) scale(1.08);
    background: {{ section.settings.icon_hover_bg_color }};
  }

  .baitandstrike-benefit__content-{{ section.id }} {
    flex: 1;
  }

  .baitandstrike-benefit__content-{{ section.id }} h3 {
    margin: 0 0 8px;
    color: {{ section.settings.text_color }};
    font-size: 18px;
    line-height: 1.3;
    font-weight: 700;
  }

  .baitandstrike-benefit__content-{{ section.id }} p {
    margin: 0;
    color: {{ section.settings.subtext_color }};
    font-size: 14px;
    line-height: 1.65;
  }

  @media screen and (max-width: 990px) {
    .baitandstrike-benefits__grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media screen and (max-width: 600px) {
    .baitandstrike-benefits__grid-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 0 18px;
    }

    .baitandstrike-benefit-{{ section.id }} {
      gap: 15px;
    }

    .baitandstrike-benefit__icon-{{ section.id }} {
      flex-basis: 50px;
      width: 50px;
      height: 50px;
      font-size: 23px;
    }

    .baitandstrike-benefit__content-{{ section.id }} h3 {
      font-size: 16px;
    }

    .baitandstrike-benefit__content-{{ section.id }} p {
      font-size: 13px;
    }
  }
{%- endstyle -%}

<section class="baitandstrike-benefits-{{ section.id }} section-{{ section.id }}-padding">
  <div class="baitandstrike-benefits__grid-{{ section.id }}">
    {%- for block in section.blocks -%}
      <div class="baitandstrike-benefit-{{ section.id }}" {{ block.shopify_attributes }}>
        <div class="baitandstrike-benefit__icon-{{ section.id }}">
          {{ block.settings.icon }}
        </div>
        <div class="baitandstrike-benefit__content-{{ section.id }}">
          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bait & Strike Benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Pengaturan Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Jumlah kolom di Desktop"
    },
    {
      "type": "number",
      "id": "max_width",
      "label": "Lebar Maksimal Grid (px)",
      "default": 1250
    },
    {
      "type": "header",
      "content": "Pengaturan Warna"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Warna Latar Belakang",
      "default": "#075985"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Warna Judul & Teks",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Warna Deskripsi",
      "default": "#e0f2fe"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Warna Background Ikon",
      "default": "rgba(255, 255, 255, 0.15)"
    },
    {
      "type": "color",
      "id": "icon_hover_bg_color",
      "label": "Warna Hover Background Ikon",
      "default": "rgba(255, 255, 255, 0.25)"
    },
    {
      "type": "header",
      "content": "Padding Section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Atas (Desktop)",
      "default": 55
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bawah (Desktop)",
      "default": 55
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Atas (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bawah (Mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Item Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Ikon / Emoji",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Judul",
          "default": "Judul Keunggulan"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Deskripsi",
          "default": "Tuliskan penjelasan keunggulan layanan atau produk kamu di sini."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bait & Strike Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "🚚",
            "title": "Pengiriman Cepat & Terjangkau",
            "text": "Pesanan kamu akan kami proses dengan cepat menggunakan layanan pengiriman terpercaya ke seluruh Indonesia."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🔒",
            "title": "Pembayaran Aman",
            "text": "Nikmati berbagai metode pembayaran yang aman dan praktis untuk memudahkan setiap transaksi kamu."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🎣",
            "title": "Dikelola Angler Berpengalaman",
            "text": "Kami memahami kebutuhan pemancing karena kami juga memiliki pengalaman dan passion di dunia mancing."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "⭐",
            "title": "Produk & Brand Pilihan",
            "text": "Temukan berbagai perlengkapan mancing dari brand terpercaya untuk mendukung aktivitas memancing kamu."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🎁",
            "title": "Promo & Reward Pelanggan",
            "text": "Dapatkan berbagai promo menarik dan keuntungan khusus untuk pelanggan setia BAITANDSTRIKE."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "💰",
            "title": "Harga Kompetitif",
            "text": "Kami berusaha memberikan harga terbaik untuk berbagai kebutuhan alat pancing dan aksesoris kamu."
          }
        }
      ]
    }
  ]
}
{% endschema %}