
{% comment %}
  ============================================================
  BAITANDSTRIKE — PREMIUM FAQ
  BNS COLOUR GUIDE
  BLUE   : #3282C0
  YELLOW : #FCDD16

  FEATURES:
  - Premium FAQ cards
  - Numbering
  - Animated accordion
  - Fishing-inspired decorative pattern
  - Background glow
  - Trust strip
  - Premium CTA
  - Responsive mobile
  - Shopify Theme Editor compatible
  ============================================================
{% endcomment %}

<section id="bs-faq-{{ section.id }}" class="bs-faq">

  <!-- Decorative background -->
  <div class="bs-faq__bg">
    <div class="bs-faq__glow bs-faq__glow--blue"></div>
    <div class="bs-faq__glow bs-faq__glow--yellow"></div>

    <div class="bs-faq__wave bs-faq__wave--one"></div>
    <div class="bs-faq__wave bs-faq__wave--two"></div>

    <div class="bs-faq__dot bs-faq__dot--one"></div>
    <div class="bs-faq__dot bs-faq__dot--two"></div>
    <div class="bs-faq__dot bs-faq__dot--three"></div>
  </div>

  <div class="bs-faq__container">

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="bs-faq__header">

      {% if section.settings.eyebrow != blank %}
        <div class="bs-faq__eyebrow">
          <span class="bs-faq__eyebrow-line"></span>

          <span>
            {{ section.settings.eyebrow | escape }}
          </span>

          <span class="bs-faq__eyebrow-line"></span>
        </div>
      {% endif %}

      <div class="bs-faq__badge">
        <span class="bs-faq__badge-icon">?</span>
        <span>NEED HELP?</span>
      </div>

      <h1>
        {{ section.settings.title | escape }}
      </h1>

      {% if section.settings.subtitle != blank %}
        <p>
          {{ section.settings.subtitle | escape }}
        </p>
      {% endif %}

      <div class="bs-faq__header-accent">
        <span></span>
        <i></i>
        <span></span>
      </div>

    </header>


    <!-- ======================================================
         FAQ LIST
    ======================================================= -->

    <div class="bs-faq__list">

      {% for block in section.blocks %}

        <article
          class="bs-faq__item{% if block.settings.open_default %} is-open{% endif %}"
          {{ block.shopify_attributes }}
        >

          <button
            type="button"
            class="bs-faq__question"
            aria-expanded="{% if block.settings.open_default %}true{% else %}false{% endif %}"
            aria-controls="bs-answer-{{ section.id }}-{{ block.id }}"
          >

            <div class="bs-faq__question-left">

              <span class="bs-faq__number">
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              </span>

              <span class="bs-faq__question-text">
                {{ block.settings.question | escape }}
              </span>

            </div>

            <span class="bs-faq__plus" aria-hidden="true">
              <i></i>
              <i></i>
            </span>

          </button>


          <div
            id="bs-answer-{{ section.id }}-{{ block.id }}"
            class="bs-faq__answer"
            {% unless block.settings.open_default %}
              hidden
            {% endunless %}
          >

            <div class="bs-faq__answer-inner">

              <div class="bs-faq__answer-line"></div>

              <div class="bs-faq__answer-content">
                {{ block.settings.answer }}
              </div>

            </div>

          </div>

        </article>

      {% endfor %}

    </div>


    <!-- ======================================================
         TRUST STRIP
    ======================================================= -->

    {% if section.settings.show_trust %}
      <div class="bs-faq__trust">

        <div class="bs-faq__trust-item">

          <span class="bs-faq__trust-icon">
            ✓
          </span>

          <div>
            <strong>
              {{ section.settings.trust_1_title | escape }}
            </strong>

            <small>
              {{ section.settings.trust_1_text | escape }}
            </small>
          </div>

        </div>


        <div class="bs-faq__trust-divider"></div>


        <div class="bs-faq__trust-item">

          <span class="bs-faq__trust-icon">
            ★
          </span>

          <div>
            <strong>
              {{ section.settings.trust_2_title | escape }}
            </strong>

            <small>
              {{ section.settings.trust_2_text | escape }}
            </small>
          </div>

        </div>


        <div class="bs-faq__trust-divider"></div>


        <div class="bs-faq__trust-item">

          <span class="bs-faq__trust-icon">
            →
          </span>

          <div>
            <strong>
              {{ section.settings.trust_3_title | escape }}
            </strong>

            <small>
              {{ section.settings.trust_3_text | escape }}
            </small>
          </div>

        </div>

      </div>
    {% endif %}


    <!-- ======================================================
         PREMIUM CTA
    ======================================================= -->

    {% if section.settings.show_contact %}

      <div class="bs-faq__cta">

        <div class="bs-faq__cta-pattern"></div>

        <div class="bs-faq__cta-content">

          <div class="bs-faq__cta-label">
            <span></span>
            {{ section.settings.cta_label | escape }}
          </div>

          <h2>
            {{ section.settings.contact_title | escape }}
          </h2>

          <p>
            {{ section.settings.contact_text | escape }}
          </p>

        </div>


        {% if section.settings.contact_link != blank %}

          <a
            href="{{ section.settings.contact_link }}"
            class="bs-faq__cta-button"
          >

            <span>
              {{ section.settings.contact_button | escape }}
            </span>

            <b>→</b>

          </a>

        {% endif %}

      </div>

    {% endif %}

  </div>

</section>


<style>

/* ============================================================
   ROOT
============================================================ */

#bs-faq-{{ section.id }} {

  --bns-blue: #3282C0;
  --bns-yellow: #FCDD16;

  --bns-dark: #111820;
  --bns-text: #1c2933;
  --bns-muted: #6b7880;

  --bns-border: #dfe7ec;

  --bns-white: #ffffff;
  --bns-soft: #f5f9fc;

  position: relative;

  overflow: hidden;

  background:
    linear-gradient(
      180deg,
      #ffffff 0%,
      #f8fbfd 100%
    );

  color: var(--bns-text);

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


#bs-faq-{{ section.id }} * {
  box-sizing: border-box;
}


/* ============================================================
   TOP BRAND BAR
============================================================ */

#bs-faq-{{ section.id }}::before {

  content: "";

  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 4px;

  background:
    linear-gradient(
      90deg,
      var(--bns-blue) 0%,
      var(--bns-blue) 70%,
      var(--bns-yellow) 70%,
      var(--bns-yellow) 100%
    );

  z-index: 5;
}


/* ============================================================
   BACKGROUND DECORATION
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__bg {

  position: absolute;

  inset: 0;

  pointer-events: none;

  overflow: hidden;

  z-index: 0;
}


#bs-faq-{{ section.id }} .bs-faq__glow {

  position: absolute;

  border-radius: 50%;

  filter: blur(5px);

  opacity: .45;

}


#bs-faq-{{ section.id }} .bs-faq__glow--blue {

  width: 360px;
  height: 360px;

  right: -170px;
  top: 120px;

  background:
    radial-gradient(
      circle,
      rgba(50,130,192,.16) 0%,
      rgba(50,130,192,0) 70%
    );
}


#bs-faq-{{ section.id }} .bs-faq__glow--yellow {

  width: 280px;
  height: 280px;

  left: -150px;
  bottom: 170px;

  background:
    radial-gradient(
      circle,
      rgba(252,221,22,.12) 0%,
      rgba(252,221,22,0) 70%
    );
}


/* ============================================================
   FISHING WAVE PATTERN
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__wave {

  position: absolute;

  width: 650px;
  height: 250px;

  border: 1px solid rgba(50,130,192,.07);

  border-radius: 50%;

  transform: rotate(-12deg);

}


#bs-faq-{{ section.id }} .bs-faq__wave--one {

  right: -330px;
  top: 380px;
}


#bs-faq-{{ section.id }} .bs-faq__wave--two {

  right: -360px;
  top: 410px;

  transform: rotate(-12deg) scale(.9);
}


#bs-faq-{{ section.id }} .bs-faq__dot {

  position: absolute;

  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--bns-blue);

  opacity: .15;

  animation: bnsFaqFloat 5s ease-in-out infinite;
}


#bs-faq-{{ section.id }} .bs-faq__dot--one {

  top: 180px;
  left: 9%;
}


#bs-faq-{{ section.id }} .bs-faq__dot--two {

  top: 420px;
  right: 8%;

  background: var(--bns-yellow);

  animation-delay: 1s;
}


#bs-faq-{{ section.id }} .bs-faq__dot--three {

  bottom: 250px;
  left: 6%;

  animation-delay: 2s;
}


@keyframes bnsFaqFloat {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10px);
  }

}


/* ============================================================
   CONTAINER
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__container {

  position: relative;

  z-index: 2;

  max-width: {{ section.settings.max_width }}px;

  margin: 0 auto;

  padding:
    {{ section.settings.top_padding }}px
    24px
    {{ section.settings.bottom_padding }}px;
}


/* ============================================================
   HEADER
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__header {

  max-width: 780px;

  margin:
    0 auto
    {{ section.settings.header_spacing }}px;

  text-align: center;

  animation:
    bnsFaqHeader .7s ease both;
}


@keyframes bnsFaqHeader {

  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}


/* EYEBROW */

#bs-faq-{{ section.id }} .bs-faq__eyebrow {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  margin-bottom: 13px;

  color: var(--bns-blue);

  font-size: 11px;

  font-weight: 800;

  letter-spacing: .18em;

  text-transform: uppercase;
}


#bs-faq-{{ section.id }} .bs-faq__eyebrow-line {

  width: 24px;
  height: 2px;

  background: var(--bns-yellow);
}


/* HELP BADGE */

#bs-faq-{{ section.id }} .bs-faq__badge {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  padding:
    6px
    10px;

  margin-bottom: 14px;

  border:
    1px solid
    rgba(50,130,192,.15);

  border-radius: 100px;

  background:
    rgba(50,130,192,.045);

  color: var(--bns-blue);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .12em;
}


#bs-faq-{{ section.id }} .bs-faq__badge-icon {

  width: 17px;
  height: 17px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: var(--bns-yellow);

  color: var(--bns-dark);

  font-size: 10px;

  font-weight: 900;
}


/* TITLE */

#bs-faq-{{ section.id }} h1 {

  margin: 0 0 14px;

  color: var(--bns-dark);

  font-size:
    clamp(
      30px,
      4vw,
      46px
    );

  line-height: 1.05;

  font-weight: 900;

  letter-spacing: -.035em;
}


#bs-faq-{{ section.id }} .bs-faq__header p {

  max-width: 690px;

  margin: 0 auto;

  color: var(--bns-muted);

  font-size: 14px;

  line-height: 1.75;
}


/* HEADER ACCENT */

#bs-faq-{{ section.id }} .bs-faq__header-accent {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 5px;

  margin-top: 21px;
}


#bs-faq-{{ section.id }} .bs-faq__header-accent span {

  width: 28px;
  height: 2px;

  background: var(--bns-blue);
}


#bs-faq-{{ section.id }} .bs-faq__header-accent span:last-child {

  background: var(--bns-yellow);
}


#bs-faq-{{ section.id }} .bs-faq__header-accent i {

  width: 7px;
  height: 7px;

  transform: rotate(45deg);

  background: var(--bns-yellow);
}


/* ============================================================
   FAQ LIST
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__list {

  max-width: 850px;

  margin: 0 auto;

  display: flex;

  flex-direction: column;

  gap: 10px;
}


/* ============================================================
   FAQ CARD
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__item {

  position: relative;

  overflow: hidden;

  border:
    1px solid
    var(--bns-border);

  border-radius: 4px;

  background: var(--bns-white);

  box-shadow:
    0 3px 15px rgba(17,24,32,.035);

  transition:
    border-color .25s ease,
    box-shadow .25s ease,
    transform .25s ease;

  animation:
    bnsFaqItem .55s ease both;
}


#bs-faq-{{ section.id }} .bs-faq__item:nth-child(1) {
  animation-delay: .05s;
}

#bs-faq-{{ section.id }} .bs-faq__item:nth-child(2) {
  animation-delay: .09s;
}

#bs-faq-{{ section.id }} .bs-faq__item:nth-child(3) {
  animation-delay: .13s;
}

#bs-faq-{{ section.id }} .bs-faq__item:nth-child(4) {
  animation-delay: .17s;
}

#bs-faq-{{ section.id }} .bs-faq__item:nth-child(5) {
  animation-delay: .21s;
}

#bs-faq-{{ section.id }} .bs-faq__item:nth-child(6) {
  animation-delay: .25s;
}


@keyframes bnsFaqItem {

  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}


#bs-faq-{{ section.id }} .bs-faq__item:hover {

  border-color:
    rgba(50,130,192,.35);

  box-shadow:
    0 8px 25px rgba(50,130,192,.08);

  transform: translateY(-1px);
}


#bs-faq-{{ section.id }} .bs-faq__item.is-open {

  border-color:
    rgba(50,130,192,.35);

  box-shadow:
    0 10px 30px rgba(50,130,192,.09);
}


/* LEFT ACTIVE LINE */

#bs-faq-{{ section.id }} .bs-faq__item::before {

  content: "";

  position: absolute;

  left: 0;
  top: 0;
  bottom: 0;

  width: 3px;

  background: var(--bns-blue);

  transform:
    scaleY(0);

  transform-origin: center;

  transition:
    transform .3s ease;
}


#bs-faq-{{ section.id }} .bs-faq__item.is-open::before {

  transform: scaleY(1);
}


/* ============================================================
   QUESTION
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__question {

  width: 100%;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  padding:
    20px
    20px
    20px
    18px;

  border: 0;

  background: transparent;

  color: var(--bns-dark);

  cursor: pointer;

  text-align: left;

  font: inherit;

  transition:
    color .2s ease;
}


#bs-faq-{{ section.id }} .bs-faq__question:hover {

  color: var(--bns-blue);
}


#bs-faq-{{ section.id }} .bs-faq__question-left {

  display: flex;

  align-items: center;

  gap: 16px;

  min-width: 0;
}


/* NUMBER */

#bs-faq-{{ section.id }} .bs-faq__number {

  flex: 0 0 34px;

  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: var(--bns-soft);

  color: var(--bns-blue);

  font-size: 10px;

  font-weight: 900;

  letter-spacing: .04em;

  transition:
    background .25s ease,
    color .25s ease,
    transform .25s ease;
}


#bs-faq-{{ section.id }} .bs-faq__item.is-open
.bs-faq__number {

  background: var(--bns-yellow);

  color: var(--bns-dark);

  transform: scale(1.05);
}


/* QUESTION TEXT */

#bs-faq-{{ section.id }} .bs-faq__question-text {

  font-size: 14px;

  line-height: 1.5;

  font-weight: 700;
}


/* ============================================================
   PLUS ICON
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__plus {

  position: relative;

  flex: 0 0 32px;

  width: 32px;
  height: 32px;

  border:
    1px solid
    var(--bns-border);

  border-radius: 50%;

  background: #fff;

  color: var(--bns-blue);

  transition:
    background .25s ease,
    border-color .25s ease,
    transform .3s ease;
}


#bs-faq-{{ section.id }} .bs-faq__plus i {

  position: absolute;

  left: 9px;
  top: 14px;

  width: 12px;
  height: 2px;

  border-radius: 5px;

  background: currentColor;
}


#bs-faq-{{ section.id }} .bs-faq__plus i:last-child {

  transform: rotate(90deg);

  transition:
    transform .3s ease;
}


/* ACTIVE PLUS */

#bs-faq-{{ section.id }}
.bs-faq__item.is-open
.bs-faq__plus {

  background: var(--bns-yellow);

  border-color: var(--bns-yellow);

  color: var(--bns-dark);

  transform: rotate(90deg);
}


#bs-faq-{{ section.id }}
.bs-faq__item.is-open
.bs-faq__plus i:last-child {

  transform: rotate(0deg);
}


/* ============================================================
   ANSWER
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__answer[hidden] {

  display: none;
}


#bs-faq-{{ section.id }} .bs-faq__answer {

  animation:
    bnsFaqAnswer .28s ease both;
}


@keyframes bnsFaqAnswer {

  from {

    opacity: 0;

    transform:
      translateY(-6px);

  }

  to {

    opacity: 1;

    transform:
      translateY(0);

  }

}


#bs-faq-{{ section.id }} .bs-faq__answer-inner {

  display: flex;

  gap: 16px;

  padding:
    0
    70px
    23px
    68px;
}


#bs-faq-{{ section.id }} .bs-faq__answer-line {

  width: 2px;

  flex: 0 0 2px;

  border-radius: 4px;

  background: var(--bns-yellow);
}


#bs-faq-{{ section.id }} .bs-faq__answer-content {

  color: var(--bns-muted);

  font-size: 13px;

  line-height: 1.8;
}


#bs-faq-{{ section.id }} .bs-faq__answer-content p {

  margin:
    0
    0
    10px;
}


#bs-faq-{{ section.id }} .bs-faq__answer-content p:last-child {

  margin-bottom: 0;
}


#bs-faq-{{ section.id }} .bs-faq__answer-content a {

  color: var(--bns-blue);

  font-weight: 700;
}


/* ============================================================
   TRUST STRIP
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__trust {

  max-width: 850px;

  margin:
    35px
    auto
    0;

  padding:
    18px
    20px;

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr
    auto
    1fr;

  align-items: center;

  gap: 18px;

  border:
    1px solid
    var(--bns-border);

  background:
    rgba(255,255,255,.75);

  backdrop-filter: blur(8px);
}


#bs-faq-{{ section.id }} .bs-faq__trust-item {

  display: flex;

  align-items: center;

  gap: 10px;
}


#bs-faq-{{ section.id }} .bs-faq__trust-icon {

  flex: 0 0 30px;

  width: 30px;
  height: 30px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: var(--bns-yellow);

  color: var(--bns-dark);

  font-size: 12px;

  font-weight: 900;
}


#bs-faq-{{ section.id }} .bs-faq__trust-item div {

  display: flex;

  flex-direction: column;

  gap: 2px;
}


#bs-faq-{{ section.id }} .bs-faq__trust-item strong {

  color: var(--bns-dark);

  font-size: 10px;

  font-weight: 900;

  letter-spacing: .04em;

  text-transform: uppercase;
}


#bs-faq-{{ section.id }} .bs-faq__trust-item small {

  color: var(--bns-muted);

  font-size: 10px;
}


#bs-faq-{{ section.id }} .bs-faq__trust-divider {

  width: 1px;

  height: 32px;

  background: var(--bns-border);
}


/* ============================================================
   PREMIUM CTA
============================================================ */

#bs-faq-{{ section.id }} .bs-faq__cta {

  max-width: 850px;

  margin:
    18px
    auto
    0;

  position: relative;

  overflow: hidden;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 30px;

  padding:
    30px
    32px;

  background:
    linear-gradient(
      115deg,
      #3282C0 0%,
      #2d78b2 70%,
      #256a9f 100%
    );

  color: #fff;

  box-shadow:
    0 14px 35px rgba(50,130,192,.18);
}


/* CTA PATTERN */

#bs-faq-{{ section.id }} .bs-faq__cta-pattern {

  position: absolute;

  right: -80px;
  top: -100px;

  width: 330px;
  height: 330px;

  border:
    1px solid
    rgba(255,255,255,.12);

  border-radius: 50%;
}


#bs-faq-{{ section.id }} .bs-faq__cta-pattern::before {

  content: "";

  position: absolute;

  inset: 25px;

  border:
    1px solid
    rgba(255,255,255,.09);

  border-radius: 50%;
}


#bs-faq-{{ section.id }} .bs-faq__cta-pattern::after {

  content: "";

  position: absolute;

  inset: 55px;

  border:
    1px solid
    rgba(252,221,22,.25);

  border-radius: 50%;
}


/* CTA CONTENT */

#bs-faq-{{ section.id }} .bs-faq__cta-content {

  position: relative;

  z-index: 2;
}


#bs-faq-{{ section.id }} .bs-faq__cta-label {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom: 8px;

  color: var(--bns-yellow);

  font-size: 9px;

