{% doc %}
  @prompt
    Fix the "View cart" button in the cart drawer so that when clicked, it navigates the customer to the /cart page. The button currently appears but does not function. Ensure the button has the correct href="/cart" link or a working JavaScript click handler that redirects to the cart page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cart-link-fix-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-cart-link-fix-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 12px 20px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ai-cart-link-fix-{{ ai_gen_id }}__link:hover {
    background: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-cart-link-fix-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }
{% endstyle %}

<cart-link-fix-{{ ai_gen_id }}
  class="ai-cart-link-fix-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <a
    class="ai-cart-link-fix-{{ ai_gen_id }}__link"
    href="/cart"
    data-cart-link
  >
    {{ block.settings.button_label }}
  </a>
</cart-link-fix-{{ ai_gen_id }}>

<script>
  (function() {
    class CartLinkFix{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.link = this.querySelector('[data-cart-link]');
        if (!this.link) return;
        this.link.addEventListener('click', this.handleClick.bind(this));
      }

      handleClick(event) {
        event.preventDefault();
        window.location.assign('/cart');
      }
    }

    if (!customElements.get('cart-link-fix-{{ ai_gen_id }}')) {
      customElements.define('cart-link-fix-{{ ai_gen_id }}', CartLinkFix{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Cart link fix",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View cart"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#797068"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Hover background",
      "default": "#54483c"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline",
      "default": "#001128"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Cart link fix"
    }
  ],
  "tag": null,
  "class": "cart-link-fix-block"
}
{% endschema %}