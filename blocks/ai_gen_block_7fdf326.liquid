{% doc %}
  @prompt
    Add a custom CSS snippet to hide the account/login icon button in the header navbar. The button is the person/account icon that when clicked shows a "Sign in or create account" popup with Shop Pay login, email field, Orders and Profile buttons. Hide this icon completely from the header so customers cannot access the login popup from the storefront header.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hide-account-icon-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: 0;
    overflow: hidden;
  }

  .ai-hide-account-icon-{{ ai_gen_id }} + * .header__icon--account,
  .ai-hide-account-icon-{{ ai_gen_id }} ~ * .header__icon--account,
  header .header__icon--account,
  header a[href="/account"],
  header a[href*="/account"],
  header button[aria-label*="account" i],
  header button[aria-label*="sign in" i] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
{% endstyle %}

<ai-hide-account-icon-{{ ai_gen_id }}
  class="ai-hide-account-icon-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  aria-hidden="true"
></ai-hide-account-icon-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Hide account icon",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Hide account icon"
    }
  ],
  "tag": null,
  "class": "account-icon-visibility"
}
{% endschema %}