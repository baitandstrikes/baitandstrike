{% doc %}
  @prompt
    Add a WhatsApp consultation button on the product detail page. The button should:
    - Appear on the product page, below or near the Add to Cart button
    - Be styled in WhatsApp green color (#25D366) with a WhatsApp icon
    - When clicked, open WhatsApp with a pre-filled message that includes the product name: "Halo, saya ingin konsultasi mengenai produk: [Product Name]"
    - Link to wa.me with configurable WhatsApp number in theme settings
    - Mobile-friendly, opens WhatsApp app on mobile
    - Customizable button label (default: Konsultasi via WhatsApp)
    - Toggle show/hide via theme editor
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-whatsapp-consultation-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-top: 12px;
  }

  .ai-whatsapp-consultation__link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 48px;
    padding: 12px 20px;
    box-sizing: border-box;
    border-radius: {{ block.settings.border_radius }}px;
    background: #25D366;
    color: #102b1b;
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ai-whatsapp-consultation__link-{{ ai_gen_id }}:hover {
    background: #1ebe5d;
    color: #102b1b;
  }

  .ai-whatsapp-consultation__link-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid #102b1b;
    outline-offset: 3px;
  }

  .ai-whatsapp-consultation__icon-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
  }

  @media screen and (max-width: 749px) {
    .ai-whatsapp-consultation-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

{% if block.settings.show_button and product != blank %}
  {% assign whatsapp_message = 'Halo, saya ingin konsultasi mengenai produk: ' | append: product.title %}
  {% assign whatsapp_url = 'https://wa.me/' | append: block.settings.whatsapp_number | strip | remove: '+' | remove: ' ' | append: '?text=' | append: whatsapp_message | url_encode %}
  <div class="ai-whatsapp-consultation-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <a
      class="ai-whatsapp-consultation__link-{{ ai_gen_id }}"
      href="{{ whatsapp_url }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="{{ block.settings.button_label | escape }}"
    >
      <svg class="ai-whatsapp-consultation__icon-{{ ai_gen_id }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M20.52 3.48A11.86 11.86 0 0 0 12.08 0C5.53 0 .2 5.33.2 11.88c0 2.1.55 4.15 1.6 5.96L.1 24l6.3-1.65a11.87 11.87 0 0 0 5.68 1.45h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.23-6.14-3.45-8.44ZM12.09 21.8h-.01a9.85 9.85 0 0 1-5.02-1.37l-.36-.21-3.74.98 1-3.65-.23-.38a9.85 9.85 0 0 1-1.51-5.29C2.22 6.45 6.65 2.02 12.09 2.02c2.64 0 5.12 1.03 6.98 2.89a9.82 9.82 0 0 1 2.89 6.99c0 5.44-4.43 9.87-9.87 9.87Zm5.41-7.4c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.74-1.64-2.04-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.27.5 1.7.64.72.23 1.37.2 1.89.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
      </svg>
      <span>{{ block.settings.button_label | escape }}</span>
    </a>
  </div>
{% endif %}

{% schema %}
{
  "name": "WhatsApp consultation",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "default": "628123456789"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Konsultasi via WhatsApp"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "WhatsApp consultation"
    }
  ],
  "tag": null,
  "class": "whatsapp-consultation-block"
}
{% endschema %}