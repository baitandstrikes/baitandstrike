
{% doc %}
  Floating WhatsApp button with animated pulse and auto popup bubble.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign whatsapp_number = block.settings.phone_number
  | remove: '+'
  | remove: ' '
  | remove: '-'
  | remove: '('
  | remove: ')'
%}

{% assign whatsapp_message = block.settings.prefilled_message | url_encode %}

<div
  id="whatsapp-chat-{{ ai_gen_id }}"
  class="whatsapp-chat-wrapper whatsapp-position-{{ block.settings.button_position }}"
  data-bubble-delay="{{ block.settings.bubble_delay }}"
  {{ block.shopify_attributes }}
>

  <div class="whatsapp-chat-container">

    <!-- BUBBLE -->
    <div
      class="whatsapp-chat-bubble"
      data-whatsapp-bubble
      tabindex="0"
    >
      <span class="whatsapp-bubble-dot"></span>

      <span class="whatsapp-bubble-text">
        {{ block.settings.bubble_text }}
      </span>

      <button
        type="button"
        class="whatsapp-bubble-close"
        data-bubble-close
        aria-label="Tutup"
      >
        ×
      </button>

      <span class="whatsapp-bubble-arrow"></span>
    </div>

    <!-- WHATSAPP BUTTON -->
    <a
      class="whatsapp-chat-button"
      href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="{{ block.settings.accessibility_label }}"
    >

      <!-- PULSE -->
      <span class="whatsapp-button-pulse"></span>

      <!-- GLOW -->
      <span class="whatsapp-button-glow"></span>

      <!-- SHINE DIMATIKAN -->
      <span class="whatsapp-button-shine"></span>

      <!-- ICON -->
      <svg
        class="whatsapp-icon"
        viewBox="0 0 32 32"
        aria-hidden="true"
      >
        <path
          fill="currentColor"
          d="M16.01 3C8.83 3 3 8.83 3 16c0 2.3.6 4.46 1.75 6.4L3 29l6.76-1.72A12.94 12.94 0 0 0 16.01 29C23.18 29 29 23.17 29 16S23.18 3 16.01 3Zm0 23.73c-2.02 0-4-.54-5.73-1.57l-.41-.24-4.01 1.02 1.04-3.9-.27-.43A10.74 10.74 0 0 1 5.27 16c0-5.92 4.82-10.73 10.74-10.73S26.74 10.08 26.74 16s-4.82 10.73-10.73 10.73Zm5.89-8.05c-.32-.16-1.9-.94-2.2-1.05-.29-.11-.51-.16-.72.16-.21.32-.83 1.05-1.02 1.27-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.6-.95-.85-1.59-1.89-1.77-2.21-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.99-2.37-.26-.62-.53-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.66s1.14 3.09 1.3 3.3c.16.21 2.24 3.42 5.43 4.79.76.33 1.36.53 1.82.68.77.24 1.47.21 2.02.13.62-.09 1.9-.78 2.17-1.53.27-.75.27-1.39.19-1.53-.08-.13-.29-.21-.61-.37Z"
        />
      </svg>

      <span class="whatsapp-button-label">
        WhatsApp
      </span>

    </a>
  </div>
</div>

<style>
  #whatsapp-chat-{{ ai_gen_id }} {
    --wa-size: {{ block.settings.button_size }}px;
    --wa-bottom: {{ block.settings.bottom_offset }}px;
    --wa-side: {{ block.settings.side_offset }}px;
    --wa-mobile-size: {{ block.settings.mobile_button_size }}px;
    --wa-mobile-bottom: {{ block.settings.mobile_bottom_offset }}px;
    --wa-mobile-side: {{ block.settings.mobile_side_offset }}px;

    position: fixed;
    z-index: 999999;
    bottom: var(--wa-bottom);
    max-width: {{ block.settings.desktop_width_percent }}%;
  }

  #whatsapp-chat-{{ ai_gen_id }}.whatsapp-position-right {
    right: var(--wa-side);
  }

  #whatsapp-chat-{{ ai_gen_id }}.whatsapp-position-left {
    left: var(--wa-side);
  }

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-chat-container {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  #whatsapp-chat-{{ ai_gen_id }}.whatsapp-position-left .whatsapp-chat-container {
    align-items: flex-start;
  }

  /* =========================
     WHATSAPP BUTTON
  ========================= */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-chat-button {
    position: relative;
    width: var(--wa-size);
    height: var(--wa-size);
    min-width: var(--wa-size);

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    background: #25d366;
    color: #ffffff;

    text-decoration: none;

    box-shadow:
      0 8px 25px rgba(37, 211, 102, 0.35),
      0 3px 10px rgba(0, 0, 0, 0.18);

    overflow: visible;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;

    animation: whatsappFloat-{{ ai_gen_id }} 3s ease-in-out infinite;
  }

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-chat-button:hover {
    transform: translateY(-5px) scale(1.06);

    box-shadow:
      0 14px 32px rgba(37, 211, 102, 0.45),
      0 7px 16px rgba(0, 0, 0, 0.18);
  }

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-chat-button:active {
    transform: scale(0.94);
  }

  /* =========================
     FLOAT
  ========================= */

  @keyframes whatsappFloat-{{ ai_gen_id }} {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-5px);
    }
  }

  /* =========================
     PULSE
  ========================= */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-button-pulse {
    position: absolute;
    inset: -5px;

    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.5);

    pointer-events: none;

    animation:
      whatsappPulse-{{ ai_gen_id }} 2s ease-out infinite;
  }

  @keyframes whatsappPulse-{{ ai_gen_id }} {
    0% {
      transform: scale(0.95);
      opacity: 0.75;
    }

    70% {
      transform: scale(1.38);
      opacity: 0;
    }

    100% {
      transform: scale(1.38);
      opacity: 0;
    }
  }

  /* =========================
     GLOW
  ========================= */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-button-glow {
    position: absolute;
    inset: -10px;

    border-radius: 50%;

    background: rgba(37, 211, 102, 0.18);

    filter: blur(10px);

    pointer-events: none;

    animation:
      whatsappGlow-{{ ai_gen_id }} 2.5s ease-in-out infinite;
  }

  @keyframes whatsappGlow-{{ ai_gen_id }} {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.95);
    }

    50% {
      opacity: 0.7;
      transform: scale(1.05);
    }
  }

  /* =========================
     SHINE OFF
  ========================= */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-button-shine {
    display: none !important;
  }

  /* =========================
     ICON
  ========================= */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-icon {
    position: relative;
    z-index: 5;

    width: 58%;
    height: 58%;

    display: block;

    filter:
      drop-shadow(0 2px 3px rgba(0, 0, 0, 0.15));

    transition:
      transform 0.3s ease;
  }

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-chat-button:hover .whatsapp-icon {
    transform: scale(1.08);
  }

  /* =========================
     LABEL
  ========================= */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-button-label {
    position: absolute;

    right: calc(100% + 10px);

    white-space: nowrap;

    background: #111827;
    color: #ffffff;

    font-size: 12px;
    font-weight: 600;

    padding: 6px 9px;
    border-radius: 6px;

    opacity: 0;
    transform: translateX(5px);

    pointer-events: none;

    transition: all 0.25s ease;
  }

  #whatsapp-chat-{{ ai_gen_id }}.whatsapp-position-left
  .whatsapp-button-label {
    right: auto;
    left: calc(100% + 10px);
    transform: translateX(-5px);
  }

  #whatsapp-chat-{{ ai_gen_id }}
  .whatsapp-chat-button:hover
  .whatsapp-button-label {
    opacity: 1;
    transform: translateX(0);
  }

  /* =========================
     BUBBLE
  ========================= */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-chat-bubble {
    position: relative;

    display: flex;
    align-items: center;

    gap: 9px;

    max-width: 290px;
    min-width: 180px;

    padding: 13px 42px 13px 15px;

    background: #ffffff;
    color: #1f2937;

    border-radius: 16px;

    box-shadow:
      0 10px 35px rgba(0, 0, 0, 0.15),
      0 3px 10px rgba(0, 0, 0, 0.08);

    border: 1px solid rgba(0, 0, 0, 0.06);

    opacity: 0;
    visibility: hidden;

    transform:
      translateY(12px)
      scale(0.9);

    transform-origin: bottom right;

    pointer-events: none;

    cursor: pointer;

    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(.34, 1.56, .64, 1),
      visibility 0.35s ease;
  }

  #whatsapp-chat-{{ ai_gen_id }}.whatsapp-position-left
  .whatsapp-chat-bubble {
    transform-origin: bottom left;
  }

  #whatsapp-chat-{{ ai_gen_id }}
  .whatsapp-chat-bubble.is-visible {
    opacity: 1;
    visibility: visible;

    transform:
      translateY(0)
      scale(1);

    pointer-events: auto;
  }

  #whatsapp-chat-{{ ai_gen_id }}
  .whatsapp-chat-bubble:hover {
    transform:
      translateY(-2px)
      scale(1.02);
  }

  /* DOT */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-bubble-dot {
    width: 9px;
    height: 9px;
    min-width: 9px;

    border-radius: 50%;

    background: #25d366;

    box-shadow:
      0 0 0 4px rgba(37, 211, 102, 0.12);

    animation:
      whatsappDot-{{ ai_gen_id }} 1.6s ease-in-out infinite;
  }

  @keyframes whatsappDot-{{ ai_gen_id }} {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }

    50% {
      transform: scale(1.3);
      opacity: 0.65;
    }
  }

  /* TEXT */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-bubble-text {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* CLOSE */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-bubble-close {
    position: absolute;

    top: 5px;
    right: 6px;

    width: 25px;
    height: 25px;

    padding: 0;
    border: 0;

    background: transparent;

    color: #6b7280;

    font-size: 20px;
    line-height: 20px;

    cursor: pointer;

    opacity: 0.6;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  #whatsapp-chat-{{ ai_gen_id }}
  .whatsapp-bubble-close:hover {
    opacity: 1;
    transform: rotate(90deg);
  }

  /* ARROW */

  #whatsapp-chat-{{ ai_gen_id }} .whatsapp-bubble-arrow {
    position: absolute;

    bottom: -7px;
    right: 22px;

    width: 14px;
    height: 14px;

    background: #ffffff;

    transform: rotate(45deg);

    border-right:
      1px solid rgba(0, 0, 0, 0.06);

    border-bottom:
      1px solid rgba(0, 0, 0, 0.06);
  }

  #whatsapp-chat-{{ ai_gen_id }}.whatsapp-position-left
  .whatsapp-bubble-arrow {
    right: auto;
    left: 22px;
  }

  /* =========================
     MOBILE
  ========================= */

  @media screen and (max-width: 749px) {
    #whatsapp-chat-{{ ai_gen_id }} {
      bottom: var(--wa-mobile-bottom);
      max-width: calc(100% - 24px);
    }

    #whatsapp-chat-{{ ai_gen_id }}.whatsapp-position-right {
      right: var(--wa-mobile-side);
    }

    #whatsapp-chat-{{ ai_gen_id }}.whatsapp-position-left {
      left: var(--wa-mobile-side);
    }

    #whatsapp-chat-{{ ai_gen_id }} .whatsapp-chat-button {
      width: var(--wa-mobile-size);
      height: var(--wa-mobile-size);
      min-width: var(--wa-mobile-size);
    }

    #whatsapp-chat-{{ ai_gen_id }} .whatsapp-chat-bubble {
      max-width:
        min(280px, calc(100vw - 45px));

      min-width: 0;

      padding:
        12px 38px 12px 13px;

      border-radius: 14px;
    }

    #whatsapp-chat-{{ ai_gen_id }}
    .whatsapp-bubble-text {
      font-size: 13px;
    }

    #whatsapp-chat-{{ ai_gen_id }}
    .whatsapp-button-label {
      display: none;
    }
  }

  /* =========================
     VISIBILITY
  ========================= */

  {% unless block.settings.show_desktop %}
    @media screen and (min-width: 750px) {
      #whatsapp-chat-{{ ai_gen_id }} {
        display: none !important;
      }
    }
  {% endunless %}

  {% unless block.settings.show_mobile %}
    @media screen and (max-width: 749px) {
      #whatsapp-chat-{{ ai_gen_id }} {
        display: none !important;
      }
    }
  {% endunless %}

  /* =========================
     REDUCED MOTION
  ========================= */

  @media (prefers-reduced-motion: reduce) {
    #whatsapp-chat-{{ ai_gen_id }}
    .whatsapp-chat-button,
    #whatsapp-chat-{{ ai_gen_id }}
    .whatsapp-button-pulse,
    #whatsapp-chat-{{ ai_gen_id }}
    .whatsapp-button-glow,
    #whatsapp-chat-{{ ai_gen_id }}
    .whatsapp-bubble-dot {
      animation: none !important;
    }
  }
</style>

<script>
  (function() {
    const wrapper =
      document.getElementById(
        'whatsapp-chat-{{ ai_gen_id }}'
      );

    if (!wrapper) return;

    const bubble =
      wrapper.querySelector(
        '[data-whatsapp-bubble]'
      );

    const closeButton =
      wrapper.querySelector(
        '[data-bubble-close]'
      );

    const whatsappButton =
      wrapper.querySelector(
        '.whatsapp-chat-button'
      );

    if (
      !bubble ||
      !closeButton ||
      !whatsappButton
    ) {
      return;
    }

    const storageKey =
      'whatsappBubbleClosed_{{ ai_gen_id }}';

    let closed = false;

    try {
      closed =
        sessionStorage.getItem(
          storageKey
        ) === 'true';
    } catch (error) {
      closed = false;
    }

    const delay =
      parseInt(
        wrapper.getAttribute(
          'data-bubble-delay'
        ),
        10
      ) || 5;

    function showBubble() {
      if (closed) return;

      bubble.classList.add(
        'is-visible'
      );
    }

    function closeBubble() {
      bubble.classList.remove(
        'is-visible'
      );

      closed = true;

      try {
        sessionStorage.setItem(
          storageKey,
          'true'
        );
      } catch (error) {}
    }

    if (!closed) {
      setTimeout(
        showBubble,
        delay * 1000
      );
    }

    closeButton.addEventListener(
      'click',
      function(event) {
        event.preventDefault();
        event.stopPropagation();

        closeBubble();
      }
    );

    bubble.addEventListener(
      'click',
      function(event) {
        if (
          event.target.closest(
            '[data-bubble-close]'
          )
        ) {
          return;
        }

        window.open(
          whatsappButton.href,
          '_blank',
          'noopener,noreferrer'
        );
      }
    );

    bubble.addEventListener(
      'keydown',
      function(event) {
        if (
          event.key === 'Enter' ||
          event.key === ' '
        ) {
          event.preventDefault();

          window.open(
            whatsappButton.href,
            '_blank',
            'noopener,noreferrer'
          );
        }
      }
    );
  })();
</script>

{% schema %}
{
  "name": "WhatsApp chat button",
  "tag": null,
  "class": "whatsapp-chat-block",
  "settings": [
    {
      "type": "header",
      "content": "Chat settings"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "628123456789"
    },
    {
      "type": "textarea",
      "id": "prefilled_message",
      "label": "Pre-filled message",
      "default": "Halo, saya ingin bertanya tentang produk di toko Anda."
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Chat with us on WhatsApp"
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "Button position",
      "options": [
        {
          "value": "right",
          "label": "Bottom-right"
        },
        {
          "value": "left",
          "label": "Bottom-left"
        }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Chat bubble"
    },
    {
      "type": "text",
      "id": "bubble_text",
      "label": "Bubble text",
      "default": "Ada yang bisa kami bantu?"
    },
    {
      "type": "range",
      "id": "bubble_delay",
      "label": "Bubble delay",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button size",
      "min": 48,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "bottom_offset",
      "label": "Bottom spacing",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "side_offset",
      "label": "Side spacing",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_button_size",
      "label": "Mobile size",
      "min": 44,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_bottom_offset",
      "label": "Mobile bottom spacing",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_side_offset",
      "label": "Mobile side spacing",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "WhatsApp chat button"
    }
  ]
}
{% endschema %}

