{% doc %}
  @prompt
    Create an infinite auto-scrolling customer logo slideshow section (marquee style). The section should have: a customizable heading (e.g. "Trusted by leading brands"), an infinite horizontal scrolling track that loops logos seamlessly without gaps, support for multiple logo images (at least 8 logo slots) with lazy loading, configurable scroll speed, logo size/height settings, background color and padding settings, and the logos should duplicate themselves to create a seamless infinite loop effect. The scrolling should be smooth and continuous, pausing on hover.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-marquee-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    overflow: hidden;
  }

  .ai-logo-marquee-{{ ai_gen_id }}__heading {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto {{ block.settings.heading_spacing }}px;
    padding: 0 20px;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-logo-marquee-{{ ai_gen_id }}__heading h2,
  .ai-logo-marquee-{{ ai_gen_id }}__heading p {
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-logo-marquee-{{ ai_gen_id }}__heading h2 {
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-logo-marquee-{{ ai_gen_id }}__viewport {
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }

  .ai-logo-marquee-{{ ai_gen_id }}__track {
    display: flex;
    width: max-content;
    animation: ai-logo-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-logo-marquee-{{ ai_gen_id }}__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: {{ block.settings.logo_gap }}px;
    padding-right: {{ block.settings.logo_gap }}px;
  }

  .ai-logo-marquee-{{ ai_gen_id }}__item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
  }

  .ai-logo-marquee-{{ ai_gen_id }}__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-logo-marquee-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b6b6b;
    background: rgba(0, 0, 0, 0.04);
  }

  .ai-logo-marquee-{{ ai_gen_id }}__placeholder svg {
    width: 70%;
    height: 70%;
  }

  .ai-logo-marquee-{{ ai_gen_id }}:hover .ai-logo-marquee-{{ ai_gen_id }}__track,
  .ai-logo-marquee-{{ ai_gen_id }}:focus-within .ai-logo-marquee-{{ ai_gen_id }}__track {
    animation-play-state: paused;
  }

  @keyframes ai-logo-marquee-scroll-{{ ai_gen_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media screen and (max-width: 749px) {
    .ai-logo-marquee-{{ ai_gen_id }}__heading {
      width: 100%;
    }

    .ai-logo-marquee-{{ ai_gen_id }}__heading h2 {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-logo-marquee-{{ ai_gen_id }}__track {
      animation-play-state: paused;
    }
  }
{% endstyle %}

<customer-logo-marquee-{{ ai_gen_id }}
  class="ai-logo-marquee-{{ ai_gen_id }}"
  style="width: 100%;"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <div class="ai-logo-marquee-{{ ai_gen_id }}__heading">
      <h2>{{ block.settings.heading | escape }}</h2>
    </div>
  {% endif %}

  <div class="ai-logo-marquee-{{ ai_gen_id }}__viewport" aria-label="{{ block.settings.heading | default: 'Customer logos' | escape }}">
    <div class="ai-logo-marquee-{{ ai_gen_id }}__track">
      {% for group_number in (1..2) %}
        <div class="ai-logo-marquee-{{ ai_gen_id }}__group"{% if group_number == 2 %} aria-hidden="true"{% endif %}>
          {% for i in (1..4) %}
            {% liquid
              assign logo_key = 'logo_' | append: i
              assign logo = block.settings[logo_key]
            %}
            <div class="ai-logo-marquee-{{ ai_gen_id }}__item">
              {% if logo != blank %}
                <img
                  src="{{ logo | image_url: width: 400 }}"
                  alt="{{ logo.alt | default: 'Customer logo' | escape }}"
                  width="{{ block.settings.logo_width }}"
                  height="{{ block.settings.logo_height }}"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-logo-marquee-{{ ai_gen_id }}__placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</customer-logo-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerLogoMarquee{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.addEventListener('keydown', function(event) {
          if (event.key === 'Escape') this.blur();
        });
      }
    }
    if (!customElements.get('customer-logo-marquee-{{ ai_gen_id }}')) {
      customElements.define('customer-logo-marquee-{{ ai_gen_id }}', CustomerLogoMarquee{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Customer logo marquee",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by leading brands"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
