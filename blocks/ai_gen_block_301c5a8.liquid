{% doc %}
  @prompt
    Create a step-by-step guide section with tabs and numbered cards. Design specs:
    
    TABS at the top: horizontal tab navigation with tab titles (e.g. "Cara Membeli", "Cara Menjual", "Cara Tukar Tambah"). Active tab has bold text with a yellow/gold underline indicator. Inactive tabs are gray text. Tabs are centered.
    
    CARDS below the tabs: 4 cards displayed in a horizontal row. Each card has:
    - Step number (1, 2, 3, 4) displayed in light gray large font at the top right corner of the card
    - An icon image (uploadable) centered in the upper portion of the card
    - A bold title below the icon
    - A short description paragraph below the title
    - An optional clickable link text at the bottom
    
    Cards have white background, rounded corners, subtle box shadow, and light gray overall section background. Clean minimal design.
    
    Each tab shows its own independent set of 4 step cards. All content (tab names, card icons, titles, descriptions, links) must be customizable through the Shopify theme editor. Section should have a heading above the tabs. Fully responsive and mobile-friendly.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-guide-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.section_background }};padding:{{ block.settings.section_padding }}px 20px}.ai-guide__inner-{{ ai_gen_id }}{width:{{ block.settings.desktop_width_percent }}%;max-width:1200px;margin:0 auto}.ai-guide__heading-{{ ai_gen_id }}{margin:0 0 28px;color:{{ block.settings.text_color }};text-align:center;font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.heading_size }}px;line-height:1.2}.ai-guide__tabs-{{ ai_gen_id }}{display:flex;justify-content:center;gap:34px;overflow-x:auto;margin-bottom:32px;scrollbar-width:none}.ai-guide__tabs-{{ ai_gen_id }}::-webkit-scrollbar{display:none}.ai-guide__tab-{{ ai_gen_id }}{position:relative;flex:0 0 auto;padding:0 0 12px;border:0;background:transparent;color:{{ block.settings.inactive_tab_color }};font:inherit;font-size:16px;cursor:pointer}.ai-guide__tab-{{ ai_gen_id }}[aria-selected=true]{color:{{ block.settings.active_tab_color }};font-weight:700}.ai-guide__tab-{{ ai_gen_id }}[aria-selected=true]:after{content:'';position:absolute;right:0;bottom:0;left:0;height:3px;background:{{ block.settings.accent_color }};border-radius:3px}.ai-guide__panel-{{ ai_gen_id }}{display:none}.ai-guide__panel-{{ ai_gen_id }}[aria-hidden=false]{display:grid}.ai-guide__cards-{{ ai_gen_id }}{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.ai-guide__card-{{ ai_gen_id }}{position:relative;display:flex;min-height:280px;flex-direction:column;align-items:center;padding:34px 22px 24px;background:#fff;border-radius:{{ block.settings.card_radius }}px;box-shadow:0 4px 16px rgba(0,17,40,.08);text-align:center}.ai-guide__number-{{ ai_gen_id }}{position:absolute;top:12px;right:16px;color:{{ block.settings.number_color }};font-size:32px;font-weight:700;line-height:1}.ai-guide__icon-{{ ai_gen_id }}{display:flex;width:76px;height:76px;align-items:center;justify-content:center;margin-bottom:20px}.ai-guide__icon-{{ ai_gen_id }} img,.ai-guide__icon-{{ ai_gen_id }} svg{width:100%;height:100%;object-fit:contain}.ai-guide__icon-{{ ai_gen_id }} svg{color:#a8adb4}.ai-guide__title-{{ ai_gen_id }}{margin:0 0 10px;color:{{ block.settings.text_color }};font-size:18px;line-height:1.3}.ai-guide__description-{{ ai_gen_id }}{margin:0;color:{{ block.settings.description_color }};font-size:14px;line-height:1.55}.ai-guide__link-{{ ai_gen_id }}{margin-top:auto;padding-top:18px;color:{{ block.settings.link_color }};font-size:14px;font-weight:700;text-decoration:underline;text-underline-offset:3px}@media screen and (max-width:749px){.ai-guide__inner-{{ ai_gen_id }}{width:100%}.ai-guide__tabs-{{ ai_gen_id }}{justify-content:flex-start;gap:26px}.ai-guide__cards-{{ ai_gen_id }}{grid-template-columns:repeat(2,minmax(0,1fr))}.ai-guide__card-{{ ai_gen_id }}{min-height:260px;padding-right:16px;padding-left:16px}}@media screen and (max-width:449px){.ai-guide__cards-{{ ai_gen_id }}{grid-template-columns:1fr}}
{% endstyle %}
<step-guide-{{ ai_gen_id }} class="ai-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-guide__inner-{{ ai_gen_id }}">{% if block.settings.heading != blank %}<h2 class="ai-guide__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-guide__tabs-{{ ai_gen_id }}" role="tablist" aria-label="Panduan">{% for i in (1..3) %}{% assign name_key='tab_' | append:i | append:'_name' %}<button class="ai-guide__tab-{{ ai_gen_id }}" type="button" role="tab" aria-selected="{% if i == 1 %}true{% else %}false{% endif %}" aria-controls="ai-guide-panel-{{ ai_gen_id }}-{{ i }}">{{ block.settings[name_key] | escape }}</button>{% endfor %}</div>{% for tab in (1..3) %}<div id="ai-guide-panel-{{ ai_gen_id }}-{{ tab }}" class="ai-guide__panel-{{ ai_gen_id }} ai-guide__cards-{{ ai_gen_id }}" role="tabpanel" aria-hidden="{% if tab == 1 %}false{% else %}true{% endif %}">{% for card in (1..4) %}{% assign base='tab_' | append:tab | append:'_card_' | append:card %}{% assign icon_key=base | append:'_icon' %}{% assign title_key=base | append:'_title' %}{% assign desc_key=base | append:'_description' %}{% assign link_key=base | append:'_link' %}{% assign url_key=base | append:'_url' %}<article class="ai-guide__card-{{ ai_gen_id }}"><span class="ai-guide__number-{{ ai_gen_id }}">{{ card }}</span><div class="ai-guide__icon-{{ ai_gen_id }}">{% if block.settings[icon_key] %}<img src="{{ block.settings[icon_key] | image_url: width: 180 }}" alt="" loading="lazy">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><h3 class="ai-guide__title-{{ ai_gen_id }}">{{ block.settings[title_key] | escape }}</h3><p class="ai-guide__description-{{ ai_gen_id }}">{{ block.settings[desc_key] | escape }}</p>{% if block.settings[link_key] != blank and block.settings[url_key] != blank %}<a class="ai-guide__link-{{ ai_gen_id }}" href="{{ block.settings[url_key] }}">{{ block.settings[link_key] | escape }}</a>{% endif %}</article>{% endfor %}</div>{% endfor %}</div></step-guide-{{ ai_gen_id }}>
<script>(function(){class StepGuide{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.tabs=this.querySelectorAll('[role="tab"]');this.panels=this.querySelectorAll('[role="tabpanel"]');this.tabs.forEach((tab,index)=>tab.addEventListener('click',()=>this.activate(index)))}activate(index){this.tabs.forEach((tab,i)=>tab.setAttribute('aria-selected',i===index?'true':'false'));this.panels.forEach((panel,i)=>panel.setAttribute('aria-hidden',i===index?'false':'true'))}}if(!customElements.get('step-guide-{{ ai_gen_id }}'))customElements.define('step-guide-{{ ai_gen_id }}',StepGuide{{ ai_gen_id }})})();</script>
