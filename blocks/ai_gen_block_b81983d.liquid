{% doc %}
  Modify the header cart button so that when clicked, instead of navigating to the cart page, it opens a slide-in cart drawer panel from the right side of the screen. The drawer should slide in smoothly from the right with CSS transition animation. Include a dark overlay backdrop behind the drawer, a close button X at the top right of the drawer, and display the cart items with product name, quantity, price, a remove item button, and a checkout button inside the drawer. The drawer should close when clicking the X button or the backdrop. Use Shopify AJAX Cart API to fetch and display cart contents dynamically. Do not redirect to cart page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cart-drawer-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-cart-drawer-backdrop-{{ ai_gen_id }} {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-cart-drawer-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    width: min(420px, 92vw);
    height: 100dvh;
    background: {{ block.settings.drawer_background }};
    color: {{ block.settings.drawer_text }};
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.18);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .ai-cart-drawer-block-{{ ai_gen_id }}.is-open .ai-cart-drawer-backdrop-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
  }

  .ai-cart-drawer-block-{{ ai_gen_id }}.is-open .ai-cart-drawer-{{ ai_gen_id }} {
    transform: translateX(0);
  }

  .ai-cart-drawer-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px;
    border-bottom: 1px solid rgba(43, 44, 45, 0.15);
  }

  .ai-cart-drawer-title-{{ ai_gen_id }} { margin: 0; font-size: 22px; color: inherit; }
  .ai-cart-drawer-close-{{ ai_gen_id }} {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid currentColor;
    border-radius: {{ block.settings.button_radius }}px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .ai-cart-drawer-close-{{ ai_gen_id }}:focus-visible,
  .ai-cart-drawer-checkout-{{ ai_gen_id }}:focus-visible { outline: 3px solid #1a73e8; outline-offset: 3px; }
  .ai-cart-drawer-content-{{ ai_gen_id }} { flex: 1; overflow-y: auto; padding: 20px 24px; }
  .ai-cart-drawer-status-{{ ai_gen_id }} { margin: 0; text-align: center; color: inherit; }
  .ai-cart-drawer-item-{{ ai_gen_id }} { display: grid; grid-template-columns: 72px 1fr auto; gap: 12px; align-items: start; padding: 16px 0; border-bottom: 1px solid rgba(43, 44, 45, 0.12); }
  .ai-cart-drawer-item-image-{{ ai_gen_id }} { width: 72px; height: 72px; object-fit: cover; border-radius: 6px; background: #eee; }
  .ai-cart-drawer-item-name-{{ ai_gen_id }} { margin: 0 0 7px; font-size: 15px; line-height: 1.3; }
  .ai-cart-drawer-item-meta-{{ ai_gen_id }} { margin: 0 0 5px; font-size: 13px; opacity: 0.75; }
  .ai-cart-drawer-item-price-{{ ai_gen_id }} { margin: 0 0 8px; font-size: 14px; }
  
  /* Tombol Hapus */
  .ai-cart-drawer-remove-{{ ai_gen_id }} {
    background: transparent;
    border: none;
    color: #e53935;
    font-size: 12px;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .ai-cart-drawer-remove-{{ ai_gen_id }}:hover {
    color: #b71c1c;
  }

  .ai-cart-drawer-footer-{{ ai_gen_id }} { padding: 20px 24px 24px; border-top: 1px solid rgba(43, 44, 45, 0.15); }
  .ai-cart-drawer-total-{{ ai_gen_id }} { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 16px; font-weight: 700; }
  .ai-cart-drawer-checkout-{{ ai_gen_id }} { display: block; width: 100%; padding: 14px 20px; border: 0; border-radius: {{ block.settings.button_radius }}px; background: {{ block.settings.button_background }}; color: {{ block.settings.button_text }}; text-align: center; text-decoration: none; cursor: pointer; font: inherit; }

  @media (prefers-reduced-motion: reduce) {
    .ai-cart-drawer-backdrop-{{ ai_gen_id }}, .ai-cart-drawer-{{ ai_gen_id }} { transition: none; }
  }
{% endstyle %}

<cart-drawer-{{ ai_gen_id }} class="ai-cart-drawer-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-cart-drawer-backdrop-{{ ai_gen_id }}" data-cart-backdrop></div>
  <aside class="ai-cart-drawer-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-labelledby="ai-cart-drawer-title-{{ ai_gen_id }}" aria-hidden="true">
    <div class="ai-cart-drawer-header-{{ ai_gen_id }}">
      <h2 id="ai-cart-drawer-title-{{ ai_gen_id }}" class="ai-cart-drawer-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      <button class="ai-cart-drawer-close-{{ ai_gen_id }}" type="button" data-cart-close aria-label="Tutup keranjang"><span aria-hidden="true">×</span></button>
    </div>
    <div class="ai-cart-drawer-content-{{ ai_gen_id }}" data-cart-content><p class="ai-cart-drawer-status-{{ ai_gen_id }}">Memuat keranjang…</p></div>
    <div class="ai-cart-drawer-footer-{{ ai_gen_id }}">
      <div class="ai-cart-drawer-total-{{ ai_gen_id }}"><span>Total</span><span data-cart-total>Rp0</span></div>
      <button type="button" class="ai-cart-drawer-checkout-{{ ai_gen_id }}" data-wa-checkout>{{ block.settings.checkout_label }}</button>
    </div>
  </aside>
</cart-drawer-{{ ai_gen_id }}>

<script>
(function() {
  class CartDrawer{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.drawer = this.querySelector('[role="dialog"]');
      this.content = this.querySelector('[data-cart-content]');
      this.total = this.querySelector('[data-cart-total]');
      this.checkoutBtn = this.querySelector('[data-wa-checkout]');
      this.cartData = null;

      this.querySelector('[data-cart-close]').addEventListener('click', () => this.close());
      this.querySelector('[data-cart-backdrop]').addEventListener('click', () => this.close());
      
      if (this.checkoutBtn) {
        this.checkoutBtn.addEventListener('click', () => this.checkoutToWhatsApp());
      }

      // Event delegation untuk tombol Hapus Item
      this.content.addEventListener('click', (event) => {
        const removeBtn = event.target.closest('[data-remove-key]');
        if (removeBtn) {
          const itemKey = removeBtn.getAttribute('data-remove-key');
          this.removeItem(itemKey);
        }
      });

      document.addEventListener('click', (event) => {
        const trigger = event.target.closest('a[href="/cart"], a[href="/cart/"], [data-cart-link], .header__icon--cart');
        if (!trigger) return;
        event.preventDefault();
        this.open();
      });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && this.classList.contains('is-open')) this.close(); });
    }

    async open() {
      this.classList.add('is-open'); this.drawer.setAttribute('aria-hidden', 'false'); document.documentElement.style.overflow = 'hidden';
      this.content.innerHTML = '<p class="ai-cart-drawer-status-{{ ai_gen_id }}">Memuat keranjang…</p>';
      try { 
        const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } }); 
        if (!response.ok) throw new Error(); 
        this.cartData = await response.json(); 
        this.render(this.cartData); 
      } catch (error) { 
        this.content.innerHTML = '<p class="ai-cart-drawer-status-{{ ai_gen_id }}">Keranjang gagal dimuat. Silakan coba lagi.</p>'; 
      }
    }

    close() { this.classList.remove('is-open'); this.drawer.setAttribute('aria-hidden', 'true'); document.documentElement.style.overflow = ''; }

    render(cart) {
      this.total.textContent = this.money(cart.total_price);
      if (!cart.items.length) { 
        this.content.innerHTML = '<p class="ai-cart-drawer-status-{{ ai_gen_id }}">Keranjang Anda masih kosong.</p>'; 
        if (this.checkoutBtn) this.checkoutBtn.disabled = true;
        return; 
      }
      if (this.checkoutBtn) this.checkoutBtn.disabled = false;
      
      this.content.innerHTML = cart.items.map(item => `
        <article class="ai-cart-drawer-item-{{ ai_gen_id }}">
          <img class="ai-cart-drawer-item-image-{{ ai_gen_id }}" src="${item.image || ''}" alt="${this.escape(item.product_title)}" loading="lazy">
          <div>
            <h3 class="ai-cart-drawer-item-name-{{ ai_gen_id }}">${this.escape(item.product_title)}</h3>
            <p class="ai-cart-drawer-item-meta-{{ ai_gen_id }}">Jumlah: ${item.quantity}</p>
            <p class="ai-cart-drawer-item-price-{{ ai_gen_id }}">${this.money(item.final_line_price)}</p>
            <button type="button" class="ai-cart-drawer-remove-{{ ai_gen_id }}" data-remove-key="${item.key}">Hapus</button>
          </div>
        </article>
      `).join('');
    }

    async removeItem(key) {
      try {
        const response = await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: key, quantity: 0 })
        });
        if (!response.ok) throw new Error();
        this.cartData = await response.json();
        this.render(this.cartData);
      } catch (error) {
        alert('Gagal menghapus produk. Silakan coba lagi.');
      }
    }

    checkoutToWhatsApp() {
      if (!this.cartData || !this.cartData.items.length) {
        alert('Keranjang Anda masih kosong.');
        return;
      }

      const nomorWA = "6287795361519";
      let daftarProduk = '';

      this.cartData.items.forEach((item, index) => {
        let varian = item.variant_title ? ` (${item.variant_title})` : '';
        daftarProduk += `${index + 1}. ${item.product_title}${varian} x${item.quantity}\n`;
      });

      const totalHarga = (this.cartData.total_price / 100).toLocaleString('id-ID');
      const pesan = `Hai BNS, saya ingin checkout pesanan berikut:\n\n${daftarProduk}\nTotal: Rp${totalHarga}\n\nBantu saya untuk proses pembayarannya ya min [WEB-Produk]`;

      const waUrl = `https://api.whatsapp.com/send?phone=${nomorWA}&text=${encodeURIComponent(pesan)}`;
      window.open(waUrl, '_blank');
    }

    money(value) { return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(value / 100); }
    escape(value) { const div = document.createElement('div'); div.textContent = value || ''; return div.innerHTML; }
  }
  if (!customElements.get('cart-drawer-{{ ai_gen_id }}')) customElements.define('cart-drawer-{{ ai_gen_id }}', CartDrawer{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Your cart" },
    { "type": "text", "id": "checkout_label", "label": "Checkout label", "default": "Checkout via WhatsApp" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "drawer_background", "label": "Background", "default": "#F4F4F4" },
    { "type": "color", "id": "drawer_text", "label": "Text", "default": "#2B2C2D" },
    { "type": "color", "id": "button_background", "label": "Button", "default": "#B7ACA2" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#262626" },
    { "type": "range", "id": "button_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 6 }
  ],
  "presets": [{ "name": "Cart drawer" }],
  "tag": null,
  "class": "cart-drawer-block"
}
{% endschema %}