{% doc %}
  @prompt
    di halaman ini ketika klik cart muncul dari samping kanan cart nya jangan direct ke halaman cart
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cart-drawer-controller-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: 0;
    overflow: visible;
  }
{% endstyle %}

<cart-drawer-controller-{{ ai_gen_id }}
  class="ai-cart-drawer-controller-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-cart-drawer-controller
></cart-drawer-controller-{{ ai_gen_id }}>

<script>
  (function() {
    var tagName = 'cart-drawer-controller-{{ ai_gen_id }}';

    if (customElements.get(tagName)) return;

    class CartDrawerController extends HTMLElement {
      connectedCallback() {
        this.handleClick = this.handleClick.bind(this);
        document.addEventListener('click', this.handleClick);
      }

      disconnectedCallback() {
        document.removeEventListener('click', this.handleClick);
      }

      handleClick(event) {
        var trigger = event.target.closest('a[href="/cart"], a[href$="/cart"], form[action="/cart"] button[type="submit"], form[action="/cart/add"] button[type="submit"]');

        if (!trigger) return;

        var cartDrawer = document.querySelector('cart-drawer');

        if (!cartDrawer || typeof cartDrawer.open !== 'function') return;

        if (trigger.matches('a[href="/cart"], a[href$="/cart"]')) {
          event.preventDefault();
          cartDrawer.open();
        }
      }
    }

    customElements.define(tagName, CartDrawerController);
  })();
</script>

{% schema %}
{
  "name": "Cart drawer controller",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Cart drawer controller"
    }
  ],
  "tag": null,
  "class": "cart-drawer-controller"
}
{% endschema %}